import { Theme, TipState, Glyphs, TrackItem, LyricLine, PartyMember } from "theme.slint";
import { Icon, HoverTip, IconButton, TextButton, TextField, Card, TextLink, Toggle, ScrollList, Scrub, CreditLine, TrackRow, LyricRow, ThemeChip } from "components.slint";
import { AppState } from "state.slint";

/// The queue: a header with Clear, and the rows (drag to reorder, right-click for more)
export component QueueList inherits VerticalLayout {
    spacing: 10px;
    HorizontalLayout {
        height: 22px;
        Text {
            text: "Up next";
            color: Theme.text2;
            font-size: 12px;
            font-weight: 500;
            vertical-alignment: center;
            horizontal-stretch: 1;
        }
        if AppState.queue.length > 0: TextLink {
            label: "Clear";
            clicked => {
                AppState.clear-queue();
            }
        }
    }
    Rectangle {
        vertical-stretch: 1;
        ScrollList {
            VerticalLayout {
                spacing: 2px;
                alignment: start;
                for item[i] in AppState.queue: TrackRow {
                    menu: true;
                    menu-remove: true;
                    menu-play-next => {
                        AppState.play-next-queue(i);
                    }
                    menu-remove-clicked => {
                        AppState.remove-queue(i);
                    }
                    menu-copy-link(url) => {
                        AppState.copy-text(url);
                    }
                    menu-open-web(id) => {
                        AppState.open-track-web(id);
                    }
                    artist-clicked(id) => {
                        AppState.open-artist(id);
                    }
                    item: item;
                    current: i == AppState.current-index;
                    draggable: !AppState.controls-locked;
                    line-top: AppState.drag-to == i && AppState.drag-to < AppState.drag-from;
                    line-bottom: AppState.drag-to == i && AppState.drag-to > AppState.drag-from;
                    drag-update(dy) => {
                        AppState.drag-from = i;
                        // rows are 48px tall with 2px between them
                        AppState.drag-to = Math.max(0, Math.min(AppState.queue.length - 1, i + Math.round(dy / 50px)));
                    }
                    drag-finish => {
                        if (AppState.drag-from >= 0 && AppState.drag-to != AppState.drag-from) {
                            AppState.move-queue(AppState.drag-from, AppState.drag-to);
                        }
                        AppState.drag-from = -1;
                        AppState.drag-to = -1;
                    }
                    action-glyph: Glyphs.close;
                    action-tip: "Remove";
                    hover-intent => {
                        AppState.prefetch-queue(i);
                    }
                    activated => {
                        AppState.play-queue(i);
                    }
                    action => {
                        AppState.remove-queue(i);
                    }
                }
            }
        }
        if AppState.queue.length == 0: Text {
            text: "Your queue is empty.\nAdd tracks with +";
            color: Theme.text3;
            font-size: 13px;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }
}


/// The queue as a screen of its own (the sidebar layout)
export component ScreenQueue inherits VerticalLayout {
    vertical-stretch: 1;
    QueueList { }
}
