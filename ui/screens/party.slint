import { Theme, TipState, Glyphs, TrackItem, LyricLine, PartyMember } from "../theme.slint";
import { Icon, HoverTip, IconButton, TextButton, TextField, Card, TextLink, Toggle, ScrollList, Scrub, CreditLine, TrackRow, LyricRow, ThemeChip } from "../components.slint";
import { AppState } from "../state.slint";

export component ScreenParty inherits VerticalLayout {
    spacing: 12px;
    vertical-stretch: 1;
    alignment: start;
    if AppState.party-note != "": Text {
        text: AppState.party-note;
        color: Theme.danger;
        font-size: 12px;
        wrap: word-wrap;
    }
    if AppState.party-mode == 0 && !AppState.party-server-ready: Rectangle {
        height: 72px;
        border-radius: 12px;
        background: Theme.accent-bg;
        HorizontalLayout {
            padding: 14px;
            spacing: 12px;
            VerticalLayout {
                alignment: center;
                horizontal-stretch: 1;
                Text {
                    text: "Add a party server first";
                    font-size: 13px;
                    font-weight: 500;
                    color: Theme.text;
                }
                Text {
                    text: "Parties connect through a small relay server. Paste its address in Settings.";
                    font-size: 12px;
                    color: Theme.text2;
                    wrap: word-wrap;
                }
            }
            VerticalLayout {
                alignment: center;
                TextButton {
                    label: "Open settings";
                    clicked => {
                        AppState.settings-open = true;
                        AppState.view-changed(-1);
                    }
                }
            }
        }
    }
    if AppState.party-mode == 0: Card {
        height: 116px;
        Text {
            text: "Start a party";
            font-size: 14px;
            font-weight: 500;
            color: Theme.text;
        }
        Text {
            text: "You choose what plays. Friends who join hear it at the same moment.";
            font-size: 12px;
            color: Theme.text2;
            wrap: word-wrap;
        }
        HorizontalLayout {
            padding-top: 6px;
            TextButton {
                label: "Start a party";
                primary: true;
                clicked => {
                    AppState.party-start();
                }
            }
            Rectangle {
                horizontal-stretch: 1;
            }
        }
    }
    if AppState.party-mode == 0: Card {
        height: 128px;
        Text {
            text: "Join a party";
            font-size: 14px;
            font-weight: 500;
            color: Theme.text;
        }
        Text {
            text: "Enter the code the host shares with you.";
            font-size: 12px;
            color: Theme.text2;
        }
        HorizontalLayout {
            padding-top: 6px;
            spacing: 8px;
            TextField {
                horizontal-stretch: 1;
                text <=> AppState.party-code-input;
                placeholder: "Party code";
                accepted(t) => {
                    AppState.party-join(t);
                }
            }
            VerticalLayout {
                alignment: center;
                TextButton {
                    label: "Join";
                    clicked => {
                        AppState.party-join(AppState.party-code-input);
                    }
                }
            }
        }
    }
    if AppState.party-mode > 0 && AppState.party-connecting: Text {
        text: "Connecting to the party server…";
        color: Theme.text3;
        font-size: 13px;
    }
    if AppState.party-mode == 2 && !AppState.party-connecting: Rectangle {
        height: 36px;
        border-radius: 8px;
        background: Theme.accent-bg;
        Text {
            text: AppState.party-control ? "Listening with " + AppState.party-host-name + ". Everyone can control playback." : "Listening with " + AppState.party-host-name + ". Only the host controls playback.";
            color: Theme.accent;
            font-size: 12px;
            x: 12px;
            width: parent.width - 24px;
            vertical-alignment: center;
            overflow: elide;
        }
    }
    if AppState.party-mode > 0 && !AppState.party-connecting: Card {
        height: AppState.party-mode == 1 ? 140px : 96px;
        property <bool> copied;
        Timer {
            interval: 1500ms;
            running: copied;
            triggered => {
                copied = false;
            }
        }
        if AppState.party-mode == 1: Text {
            text: "Your party code";
            font-size: 12px;
            color: Theme.text2;
        }
        if AppState.party-mode == 1: Text {
            text: AppState.party-room;
            font-size: 30px;
            font-weight: 500;
            font-family: "Consolas";
            letter-spacing: 4px;
            color: Theme.text;
        }
        if AppState.party-mode == 2: Text {
            text: AppState.party-host-name + "'s party";
            font-size: 14px;
            font-weight: 500;
            color: Theme.text;
        }
        if AppState.party-mode == 2: Text {
            text: "Code \{AppState.party-room} · \{AppState.party-members.length} listening\{AppState.party-sync != "" ? " · " + AppState.party-sync : ""}";
            font-size: 12px;
            color: Theme.text2;
        }
        HorizontalLayout {
            padding-top: 4px;
            spacing: 8px;
            if AppState.party-mode == 1: TextButton {
                label: copied ? "Copied" : "Copy code";
                clicked => {
                    AppState.copy-text(AppState.party-room);
                    copied = true;
                }
            }
            TextButton {
                label: AppState.party-mode == 1 ? "End party" : "Leave party";
                danger: true;
                clicked => {
                    AppState.party-leave();
                }
            }
            Rectangle {
                horizontal-stretch: 1;
            }
        }
    }
    if AppState.party-mode == 1 && !AppState.party-connecting: Rectangle {
        height: 52px;
        border-radius: 8px;
        background: pc-ta.has-hover ? Theme.hover : transparent;
        pc-ta := TouchArea { }
        HorizontalLayout {
            padding-left: 10px;
            padding-right: 10px;
            spacing: 12px;
            VerticalLayout {
                alignment: center;
                horizontal-stretch: 1;
                Text {
                    text: "Everyone can control";
                    font-size: 13px;
                    font-weight: 500;
                    color: Theme.text;
                }
                Text {
                    text: "Guests can play, pause, skip, seek and add songs";
                    font-size: 12px;
                    color: Theme.text2;
                    overflow: elide;
                }
            }
            VerticalLayout {
                alignment: center;
                Toggle {
                    checked: AppState.party-control;
                    toggled(on) => {
                        AppState.party-control-changed(on);
                    }
                }
            }
        }
    }
    if AppState.party-mode > 0 && !AppState.party-connecting: VerticalLayout {
        spacing: 2px;
        Text {
            text: "Listening now · \{AppState.party-members.length}";
            font-size: 12px;
            color: Theme.text2;
        }
        for m in AppState.party-members: Rectangle {
            height: 40px;
            border-radius: 8px;
            background: m-ta.has-hover ? Theme.hover : transparent;
            m-ta := TouchArea { }
            HorizontalLayout {
                padding-left: 8px;
                padding-right: 8px;
                spacing: 10px;
                VerticalLayout {
                    alignment: center;
                    Rectangle {
                        min-width: 28px;
                        max-width: 28px;
                        min-height: 28px;
                        max-height: 28px;
                        border-radius: 14px;
                        background: Theme.accent-bg;
                        Text {
                            text: m.initial;
                            color: Theme.accent;
                            font-size: 12px;
                            font-weight: 500;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }
                }
                Text {
                    text: m.name;
                    font-size: 13px;
                    color: Theme.text;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                    overflow: elide;
                }
                if m.tag != "": VerticalLayout {
                    alignment: center;
                    Rectangle {
                        min-width: pill-text.preferred-width + 16px;
                        max-width: pill-text.preferred-width + 16px;
                        height: 20px;
                        border-radius: 10px;
                        background: m.tag == "In sync" ? Theme.success-bg : (m.tag == "Host" ? Theme.accent-bg : Theme.surface);
                        pill-text := Text {
                            text: m.tag;
                            font-size: 11px;
                            color: m.tag == "In sync" ? Theme.success : (m.tag == "Host" ? Theme.accent : Theme.text2);
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }
                }
            }
        }
    }
}
