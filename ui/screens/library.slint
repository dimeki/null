import { Theme, TipState, Glyphs, TrackItem, LyricLine, PartyMember } from "../theme.slint";
import { Icon, HoverTip, IconButton, TabButton, TextButton, TextField, Card, TextLink, Toggle, ScrollList, Scrub, CreditLine, TrackRow, LyricRow, ThemeChip } from "../components.slint";
import { AppState } from "../state.slint";

export component ScreenLibrary inherits VerticalLayout {
    spacing: 10px;
    vertical-stretch: 1;
    HorizontalLayout {
        height: 26px;
        spacing: 8px;
        Text {
            text: "Your playlists";
            color: Theme.text2;
            font-size: 12px;
            font-weight: 500;
            vertical-alignment: center;
            horizontal-stretch: 1;
        }
        IconButton {
            glyph: Glyphs.refresh;
            size: 26px;
            tip: "Refresh";
            tip-below: true;
            clicked => {
                AppState.refresh-library();
            }
        }
        TextLink {
            label: "Sign out";
            clicked => {
                AppState.sign-out();
            }
        }
    }
    Rectangle {
        vertical-stretch: 1;
        ScrollList {
            VerticalLayout {
                spacing: 2px;
                alignment: start;
                for item[i] in AppState.playlists: TrackRow {
                    item: item;
                    playable: false;
                    activated => {
                        AppState.in-playlist = true;
                        AppState.open-playlist(i);
                    }
                }
            }
        }
        if AppState.playlists.length == 0: Text {
            text: AppState.library-loading ? "Loading your library…" : (AppState.library-note != "" ? AppState.library-note : "No playlists found");
            color: Theme.text3;
            font-size: 14px;
            wrap: word-wrap;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }
}
