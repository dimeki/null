import { Theme, TipState, Glyphs, TrackItem, LyricLine, PartyMember } from "../theme.slint";
import { Icon, HoverTip, IconButton, TextButton, TextField, Card, TextLink, Toggle, ScrollList, Scrub, CreditLine, TrackRow, LyricRow, ThemeChip } from "../components.slint";
import { AppState } from "../state.slint";

export component ScreenSearch inherits VerticalLayout {
    spacing: 10px;
    vertical-stretch: 1;
    Rectangle {
        height: 38px;
        border-radius: 8px;
        border-width: 1px;
        border-color: input.has-focus ? Theme.accent : Theme.border;
        background: Theme.surface;
        Icon {
            glyph: Glyphs.search;
            tint: Theme.text3;
            x: 10px;
            y: (parent.height - self.height) / 2;
            width: 18px;
            height: 18px;
        }
        if AppState.query == "": Text {
            text: "Search songs, artists, albums";
            color: Theme.text3;
            font-size: 14px;
            x: 36px;
            y: (parent.height - self.height) / 2;
        }
        input := TextInput {
            text <=> AppState.query;
            x: 36px;
            y: 0px;
            height: parent.height;
            vertical-alignment: center;
            width: parent.width - 48px;
            font-size: 14px;
            color: Theme.text;
            accepted => {
                AppState.search(AppState.query);
                // hand the keyboard back, so Space and the arrows work on the results
                AppState.keys-focus-nonce += 1;
            }
        }
        Timer {
            interval: 60ms;
            running: AppState.want-search-focus;
            triggered => {
                AppState.want-search-focus = false;
                input.focus();
                // so the next thing typed replaces the old search
                input.select-all();
            }
        }
    }
    Rectangle {
        vertical-stretch: 1;
        ScrollList {
            VerticalLayout {
                spacing: 2px;
                alignment: start;
                for item[i] in AppState.results: TrackRow {
                    menu: true;
                    menu-add: true;
                    menu-play-next => {
                        AppState.play-next-result(i);
                    }
                    menu-add-clicked => {
                        AppState.add-result(i);
                    }
                    menu-copy-link(url) => {
                        AppState.copy-text(url);
                    }
                    menu-open-web(id) => {
                        AppState.open-track-web(id);
                    }
                    artist-clicked(id) => {
                        AppState.open-artist(id);
                    }
                    item: item;
                    action-glyph: Glyphs.plus;
                    action-tip: "Add to queue";
                    hover-intent => {
                        AppState.prefetch-result(i);
                    }
                    activated => {
                        AppState.play-result(i);
                    }
                    action => {
                        AppState.add-result(i);
                    }
                }
            }
        }
        if AppState.results.length == 0: Text {
            text: AppState.searching ? "Searching…" : (AppState.search-note != "" ? AppState.search-note : "Search for something to play");
            color: Theme.text3;
            font-size: 14px;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }
}
