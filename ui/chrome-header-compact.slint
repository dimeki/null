import { Theme, Glyphs } from "theme.slint";
import { Icon, IconButton, SegTab } from "components.slint";
import { AppState } from "state.slint";

/// A segmented control for the main screens, a Queue button and Settings (the compact layout)
export component HeaderCompact inherits HorizontalLayout {
    height: 34px;
    spacing: 10px;
    Rectangle {
        border-radius: 10px;
        background: Theme.hover;
        HorizontalLayout {
            padding: 3px;
            spacing: 2px;
            SegTab {
                label: "Search";
                active: AppState.tab == 0 && !AppState.settings-open;
                clicked => {
                    AppState.go-tab(0);
                }
            }
            SegTab {
                label: "Library";
                active: AppState.tab == 1 && !AppState.settings-open;
                clicked => {
                    AppState.go-tab(1);
                }
            }
            SegTab {
                label: "Lyrics";
                active: AppState.tab == 2 && !AppState.settings-open;
                clicked => {
                    AppState.go-tab(2);
                }
            }
            SegTab {
                label: "Party";
                active: AppState.tab == 3 && !AppState.settings-open;
                clicked => {
                    AppState.go-tab(3);
                }
            }
        }
    }
    Rectangle {
        horizontal-stretch: 1;
    }
    Rectangle {
        min-width: queue-row.preferred-width + 8px;
        max-width: queue-row.preferred-width + 8px;
        border-radius: 10px;
        border-width: 1px;
        border-color: (AppState.tab == 4 && !AppState.settings-open) ? Theme.accent : Theme.border;
        background: (AppState.tab == 4 && !AppState.settings-open) ? Theme.accent-bg : (queue-ta.has-hover ? Theme.hover : Theme.surface);
        queue-row := HorizontalLayout {
            padding-left: 12px;
            padding-right: 12px;
            spacing: 7px;
            VerticalLayout {
                alignment: center;
                Icon {
                    glyph: Glyphs.queue;
                    tint: (AppState.tab == 4 && !AppState.settings-open) ? Theme.accent : Theme.text2;
                    width: 16px;
                    height: 16px;
                }
            }
            Text {
                text: AppState.queue.length > 0 ? "Queue · \{AppState.queue.length}" : "Queue";
                font-size: 13px;
                color: (AppState.tab == 4 && !AppState.settings-open) ? Theme.accent : Theme.text;
                vertical-alignment: center;
            }
        }
        queue-ta := TouchArea {
            mouse-cursor: pointer;
            clicked => {
                AppState.go-tab(4);
            }
        }
    }
    VerticalLayout {
        alignment: center;
        IconButton {
            glyph: Glyphs.settings;
            size: 30px;
            tip: "Settings";
            tip-below: true;
            on: AppState.settings-open;
            clicked => {
                AppState.toggle-settings();
            }
        }
    }
}
