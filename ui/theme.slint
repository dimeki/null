import { Palette } from "std-widgets.slint";

export struct TrackItem {
    id: string,
    title: string,
    channel: string,
    /// `channel` split into the artist (a link when `artist-id` is set) and the rest ("Album")
    artist: string,
    rest: string,
    artist-id: string,
    duration: string,
    thumb: image,
}

export struct LyricLine {
    text: string,
    time: float,
}

export struct PartyMember {
    name: string,
    initial: string,
    /// "Host", or how a guest is keeping up ("In sync", "Catching up…")
    tag: string,
}

export global Theme {
    /// Performance saving: no animations, no covers
    in-out property <bool> perf;
    /// 0 follows Windows, 1 is always dark, 2 is always light
    in-out property <int> scheme: 0;
    out property <bool> dark: scheme == 1 || (scheme == 0 && Palette.color-scheme == ColorScheme.dark);
    out property <color> bg: dark ? #1c1c1e : #ffffff;
    out property <color> surface: dark ? #262629 : #f5f5f3;
    out property <color> border: dark ? #3a3a3f : #e3e3df;
    out property <color> border-strong: dark ? #55555c : #c9c9c3;
    out property <color> hover: dark ? #ffffff14 : #0000000d;
    out property <color> text: dark ? #f2f2f0 : #1a1a18;
    out property <color> text2: dark ? #a9a9a3 : #66665f;
    out property <color> text3: dark ? #78786f : #9a9a92;
    out property <color> accent: dark ? #7ab2ff : #2b6de0;
    out property <color> accent-bg: dark ? #25395a : #e4edfc;
    out property <color> accent-fill: dark ? #3b7be8 : #2b6de0;
    out property <color> danger: dark ? #ff8a80 : #c92a2a;
    out property <color> success: dark ? #7fd89b : #1f8a4c;
    out property <color> success-bg: dark ? #1f3a2a : #e1f3e8;
    out property <duration> fade: perf ? 0ms : 120ms;
}

/// The tooltip currently shown; rows and buttons fill it in, the window draws it on top of everything
export global TipState {
    in-out property <string> text;
    in-out property <length> x;
    in-out property <length> y;
    in-out property <bool> above: true;
    in-out property <bool> shown;
}

