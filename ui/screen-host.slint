import { AppState } from "state.slint";
import { UpdateBanner } from "chrome-banner.slint";
import { ScreenSettings } from "screens/settings.slint";
import { ScreenArtist } from "screens/artist.slint";
import { ScreenSearch } from "screens/search.slint";
import { ScreenSignIn } from "screens/signin.slint";
import { ScreenLibrary } from "screens/library.slint";
import { ScreenPlaylist } from "screens/playlist.slint";
import { ScreenLyrics } from "screens/lyrics.slint";
import { ScreenParty } from "screens/party.slint";
import { ScreenQueue } from "chrome-queue.slint";

/// Shows the screen the user is on (and the update notice above it). Every layout puts this
/// where its content goes, so a new layout never has to know which screen is which.
export component ScreenHost inherits VerticalLayout {
    spacing: 10px;
    if AppState.update-available && !AppState.update-dismissed: UpdateBanner { }
    if AppState.settings-open: ScreenSettings { }
    if AppState.artist-open && !AppState.settings-open: ScreenArtist { }
    if !AppState.settings-open && !AppState.artist-open && AppState.tab == 0: ScreenSearch { }
    if !AppState.settings-open && !AppState.artist-open && AppState.tab == 1 && !AppState.signed-in: ScreenSignIn { }
    if !AppState.settings-open && !AppState.artist-open && AppState.tab == 1 && AppState.signed-in && !AppState.in-playlist: ScreenLibrary { }
    if !AppState.settings-open && !AppState.artist-open && AppState.tab == 1 && AppState.signed-in && AppState.in-playlist: ScreenPlaylist { }
    if !AppState.settings-open && !AppState.artist-open && AppState.tab == 2: ScreenLyrics { }
    if !AppState.settings-open && !AppState.artist-open && AppState.tab == 3: ScreenParty { }
    if !AppState.settings-open && !AppState.artist-open && AppState.tab == 4: ScreenQueue { }
}
