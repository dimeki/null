import { Theme, Glyphs } from "theme.slint";
import { IconButton, PillTab } from "components.slint";
import { AppState } from "state.slint";

/// Pill-shaped tabs along the top of the screens, with the queue and settings on the right
/// (the art-first layout)
export component HeaderBar inherits HorizontalLayout {
    height: 32px;
    spacing: 6px;
    PillTab {
        label: "Search";
        active: AppState.tab == 0 && !AppState.settings-open;
        clicked => {
            AppState.go-tab(0);
        }
    }
    PillTab {
        label: "Library";
        active: AppState.tab == 1 && !AppState.settings-open;
        clicked => {
            AppState.go-tab(1);
        }
    }
    PillTab {
        label: "Lyrics";
        active: AppState.tab == 2 && !AppState.settings-open;
        clicked => {
            AppState.go-tab(2);
        }
    }
    PillTab {
        label: "Party";
        active: AppState.tab == 3 && !AppState.settings-open;
        clicked => {
            AppState.go-tab(3);
        }
    }
    Rectangle {
        horizontal-stretch: 1;
    }
    VerticalLayout {
        alignment: center;
        IconButton {
            glyph: Glyphs.queue;
            size: 30px;
            tip: AppState.queue.length > 0 ? "Queue (\{AppState.queue.length})" : "Queue";
            tip-below: true;
            on: AppState.tab == 4 && !AppState.settings-open;
            clicked => {
                AppState.go-tab(4);
            }
        }
    }
    VerticalLayout {
        alignment: center;
        IconButton {
            glyph: Glyphs.settings;
            size: 30px;
            tip: "Settings";
            tip-below: true;
            on: AppState.settings-open;
            clicked => {
                AppState.toggle-settings();
            }
        }
    }
}
