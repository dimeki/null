import { Theme, TipState, Glyphs, TrackItem, LyricLine, PartyMember } from "theme.slint";
import { Icon, HoverTip, IconButton, TabButton, TextButton, TextField, Card, TextLink, Toggle, ScrollList, Scrub, CreditLine, TrackRow, LyricRow, ThemeChip } from "components.slint";
export { TrackItem, LyricLine, PartyMember, Theme, TipState } from "theme.slint";

export component LoginWindow inherits Window {
    title: "Sign in to YouTube Music";
    icon: @image-url("../assets/icon.png");
    background: Theme.bg;
    min-width: 480px;
    max-width: 480px;
    preferred-width: 480px;
    min-height: 720px;
    max-height: 720px;
    preferred-height: 720px;
}

export component MainWindow inherits Window {
    title: "ytmusic-lite";
    icon: @image-url("../assets/icon.png");
    min-width: 760px;
    min-height: 460px;
    preferred-width: 980px;
    preferred-height: 620px;
    // Changing this by a hair makes the whole window repaint. Windows can throw away what a
    // window last drew (after sleep or a long idle), and the app only redraws what changed.
    in property <int> repaint-nonce;
    // (two opaque colours a shade apart: anything see-through would make Windows blend the window)
    background: Math.mod(root.repaint-nonce, 2) == 0 ? Theme.bg : Theme.bg-alt;
    default-font-size: 13px;

    in-out property <string> query;
    in property <[TrackItem]> results;
    in property <[TrackItem]> queue;
    in property <int> current-index: -1;
    in property <bool> searching;
    in property <string> search-note;
    in property <string> now-title: "Nothing playing";
    in property <string> now-detail;
    /// `now-detail` split so the artist can be a link (empty while a status message shows)
    in property <string> now-artist;
    in property <string> now-rest;
    in property <string> now-artist-id;
    // artist pages. Their songs use `playlist-tracks`, so Play all and the row buttons work as in a playlist.
    in-out property <bool> artist-open;
    /// An album of the artist is open instead of the artist's own page
    in property <bool> artist-album;
    in property <bool> artist-loading;
    in property <string> artist-note;
    in property <string> artist-name;
    in property <string> artist-sub;
    in property <image> artist-image;
    in property <[TrackItem]> artist-albums;
    callback set-theme(int);
    /// The colour chip under the mouse in Settings (-1 for none), so its name is shown
    property <int> theme-hover: -1;
    callback move-queue(int, int);
    callback seek-by(float);
    /// Set by the "/" shortcut: the search box takes the keyboard as soon as it is on screen
    property <bool> want-search-focus;
    callback play-next-result(int);
    callback play-next-playlist-track(int);
    callback play-next-queue(int);
    callback open-track-web(string);
    /// Queue row being dragged, and the row it would land on (-1 when no drag)
    property <int> drag-from: -1;
    property <int> drag-to: -1;
    callback open-artist(string);
    callback open-album(int);
    callback artist-back();
    callback close-artist();
    in property <image> now-cover;
    in property <string> pos-text: "0:00";
    in property <string> dur-text: "0:00";
    in property <float> duration-secs;
    in property <float> progress;
    in property <bool> active;
    in property <bool> paused;
    in property <bool> loading;
    in property <bool> shuffle;
    in property <int> repeat-mode;
    in-out property <float> volume: 0.8;

    // 0 = search, 1 = library, 2 = lyrics
    in-out property <int> tab;
    in-out property <bool> settings-open;
    in property <bool> signed-in;
    in property <bool> signing-in;
    in property <string> auth-note;
    in-out property <string> signin-input;
    in property <[TrackItem]> playlists;
    in property <bool> library-loading;
    in property <string> library-note;
    in-out property <bool> in-playlist;
    in property <string> playlist-title;
    in property <[TrackItem]> playlist-tracks;
    in property <bool> playlist-loading;
    in property <string> playlist-note;

    in property <[LyricLine]> lyrics-lines;
    in property <bool> lyrics-synced;
    in property <int> lyrics-current: -1;
    in property <string> lyrics-source;
    in property <bool> lyrics-loading;
    in property <string> lyrics-note;

    in-out property <bool> perf-mode;
    in property <string> cache-text: "Calculating…";
    in property <string> ytdlp-version;
    in property <bool> ytdlp-updating;
    in property <string> ytdlp-note;

    // listening party: 0 = none, 1 = hosting, 2 = following a host
    in property <int> party-mode;
    in property <bool> party-connecting;
    in property <string> party-room;
    in property <string> party-host-name;
    in property <[PartyMember]> party-members;
    in property <string> party-note;
    in property <string> party-sync;
    /// The host lets everyone play, pause, skip, seek and add songs
    in property <bool> party-control;
    callback party-control-changed(bool);
    // updates
    in property <string> app-version;
    in property <bool> update-available;
    in property <string> update-version;
    in property <string> update-notes;
    /// Where the download link leads, shown next to the button
    in property <string> update-host;
    in property <bool> update-checking;
    in property <string> update-note;
    in-out property <bool> auto-update-check: true;
    property <bool> update-dismissed;
    callback check-update();
    callback open-update();
    callback set-auto-update(bool);

    in-out property <string> party-server;
    /// Parties have a server to use (typed in Settings, or built into the app)
    in property <bool> party-server-ready;
    /// The app ships with a server address, so Settings can leave the field empty
    in property <bool> party-server-built-in;
    in-out property <string> display-name;
    in-out property <string> party-code-input;
    /// Guests follow the host, so playback controls are switched off for them
    in property <bool> controls-locked;

    callback copy-text(string);
    callback party-start();
    callback party-join(string);
    callback party-leave();
    callback party-server-edited(string);
    callback display-name-edited(string);
    callback prefetch-result(int);
    callback prefetch-playlist-track(int);
    callback prefetch-queue(int);
    callback open-library();
    callback refresh-library();
    callback open-playlist(int);
    callback play-playlist-track(int);
    callback add-playlist-track(int);
    callback play-all();
    callback add-all();
    callback sign-in(string);
    callback sign-in-google();
    callback sign-out();
    callback search(string);
    callback play-result(int);
    callback add-result(int);
    callback play-queue(int);
    callback remove-queue(int);
    callback clear-queue();
    callback toggle-pause();
    callback next();
    callback prev();
    callback seek(float);
    callback set-volume(float);
    callback toggle-shuffle();
    callback cycle-repeat();
    /// Which view is showing: 0 search, 1 library, 2 lyrics, -1 settings
    callback view-changed(int);
    callback set-perf(bool);
    callback clear-cache();
    callback update-ytdlp();
    callback seek-lyric(float);

    pure function clock(secs: float) -> string {
        return "\{Math.floor(secs / 60)}:\{Math.mod(Math.floor(secs), 60) < 10 ? "0" : ""}\{Math.mod(Math.floor(secs), 60)}";
    }

    fs := FocusScope {
        init => {
            self.focus();
        }
        key-pressed(e) => {
            // typing in the search box is handled by the box itself, so these only fire elsewhere
            if (e.text == " ") {
                root.toggle-pause();
                return accept;
            }
            if (e.text == Key.LeftArrow) {
                if (e.modifiers.control) {
                    root.prev();
                } else {
                    root.seek-by(-5.0);
                }
                return accept;
            }
            if (e.text == Key.RightArrow) {
                if (e.modifiers.control) {
                    root.next();
                } else {
                    root.seek-by(5.0);
                }
                return accept;
            }
            if (e.text == Key.UpArrow || e.text == Key.DownArrow) {
                root.volume = Math.max(0.0, Math.min(1.0, root.volume + (e.text == Key.UpArrow ? 0.05 : -0.05)));
                root.set-volume(root.volume);
                return accept;
            }
            if (e.text == "/" || (e.modifiers.control && e.text == "f")) {
                root.settings-open = false;
                root.artist-open = false;
                root.close-artist();
                root.tab = 0;
                root.view-changed(0);
                root.want-search-focus = true;
                return accept;
            }
            if (e.text == Key.Escape) {
                if (root.artist-open) {
                    root.artist-back();
                } else if (root.settings-open) {
                    root.settings-open = false;
                    root.view-changed(root.tab);
                }
                fs.focus();
                return accept;
            }
            return reject;
        }
    VerticalLayout {
        HorizontalLayout {
            VerticalLayout {
                padding: 14px;
                spacing: 10px;
                horizontal-stretch: 1;
                HorizontalLayout {
                    spacing: 18px;
                    height: 28px;
                    TabButton {
                        label: "Search";
                        active: root.tab == 0 && !root.settings-open && !root.artist-open;
                        clicked => {
                            root.tab = 0;
                            root.settings-open = false;
                            root.artist-open = false;
                            root.close-artist();
                            root.view-changed(0);
                        }
                    }
                    TabButton {
                        label: "Library";
                        active: root.tab == 1 && !root.settings-open && !root.artist-open;
                        clicked => {
                            root.tab = 1;
                            root.settings-open = false;
                            root.artist-open = false;
                            root.close-artist();
                            root.view-changed(1);
                            root.open-library();
                        }
                    }
                    TabButton {
                        label: "Lyrics";
                        active: root.tab == 2 && !root.settings-open && !root.artist-open;
                        clicked => {
                            root.tab = 2;
                            root.settings-open = false;
                            root.artist-open = false;
                            root.close-artist();
                            root.view-changed(2);
                        }
                    }
                    TabButton {
                        label: "Party";
                        active: root.tab == 3 && !root.settings-open && !root.artist-open;
                        clicked => {
                            root.tab = 3;
                            root.settings-open = false;
                            root.artist-open = false;
                            root.close-artist();
                            root.view-changed(3);
                        }
                    }
                    Rectangle {
                        horizontal-stretch: 1;
                    }
                    VerticalLayout {
                        alignment: center;
                        IconButton {
                            glyph: Glyphs.settings;
                            size: 28px;
                            tip: "Settings";
                            tip-below: true;
                            on: root.settings-open;
                            clicked => {
                                root.settings-open = !root.settings-open;
                                root.view-changed(root.settings-open ? -1 : root.tab);
                            }
                        }
                    }
                }
                if root.update-available && !root.update-dismissed: Rectangle {
                    height: 40px;
                    border-radius: 8px;
                    background: Theme.accent-bg;
                    HorizontalLayout {
                        padding-left: 12px;
                        padding-right: 8px;
                        spacing: 10px;
                        VerticalLayout {
                            alignment: center;
                            horizontal-stretch: 1;
                            Text {
                                text: "Version " + root.update-version + " is available" + (root.update-notes != "" ? " · " + root.update-notes : "");
                                font-size: 12px;
                                color: Theme.text;
                                overflow: elide;
                            }
                        }
                        VerticalLayout {
                            alignment: center;
                            TextButton {
                                label: "Get update";
                                clicked => {
                                    root.open-update();
                                }
                            }
                        }
                        VerticalLayout {
                            alignment: center;
                            IconButton {
                                glyph: Glyphs.close;
                                size: 24px;
                                tip: "Dismiss";
                                tip-below: true;
                                clicked => {
                                    root.update-dismissed = true;
                                }
                            }
                        }
                    }
                }
                if root.settings-open: Rectangle {
                    vertical-stretch: 1;
                    ScrollList {
                        VerticalLayout {
                    alignment: start;
                    spacing: 2px;
                    Rectangle {
                        height: 64px;
                        border-radius: 8px;
                        background: ab-ta.has-hover ? Theme.hover : transparent;
                        ab-ta := TouchArea { }
                        HorizontalLayout {
                            padding-left: 10px;
                            padding-right: 10px;
                            spacing: 12px;
                            VerticalLayout {
                                alignment: center;
                                horizontal-stretch: 1;
                                Text {
                                    text: "Version " + root.app-version;
                                    font-size: 13px;
                                    font-weight: 500;
                                    color: Theme.text;
                                }
                                Text {
                                    text: root.update-checking ? "Checking…" : (root.update-available ? "Version " + root.update-version + " is available at " + root.update-host : (root.update-note != "" ? root.update-note : "Checks once a day"));
                                    font-size: 12px;
                                    color: Theme.text2;
                                    wrap: word-wrap;
                                }
                            }
                            VerticalLayout {
                                alignment: center;
                                TextButton {
                                    label: root.update-available ? "Get update" : "Check now";
                                    clicked => {
                                        if root.update-available {
                                            root.open-update();
                                        } else {
                                            root.check-update();
                                        }
                                    }
                                }
                            }
                            VerticalLayout {
                                alignment: center;
                                Toggle {
                                    checked: root.auto-update-check;
                                    toggled(on) => {
                                        root.auto-update-check = on;
                                        root.set-auto-update(on);
                                    }
                                }
                            }
                        }
                    }
                    Rectangle {
                        height: 64px;
                        border-radius: 8px;
                        background: pr-ta.has-hover ? Theme.hover : transparent;
                        pr-ta := TouchArea { }
                        HorizontalLayout {
                            padding-left: 10px;
                            padding-right: 10px;
                            spacing: 12px;
                            VerticalLayout {
                                alignment: center;
                                horizontal-stretch: 1;
                                Text {
                                    text: "Performance saving";
                                    font-size: 13px;
                                    font-weight: 500;
                                    color: Theme.text;
                                }
                                Text {
                                    text: "Turns off animations and covers, and refreshes the progress bar less often";
                                    font-size: 12px;
                                    color: Theme.text2;
                                    wrap: word-wrap;
                                }
                            }
                            VerticalLayout {
                                alignment: center;
                                Toggle {
                                    checked: root.perf-mode;
                                    toggled(on) => {
                                        root.perf-mode = on;
                                        root.set-perf(on);
                                    }
                                }
                            }
                        }
                    }
                    Rectangle {
                        height: 64px;
                        border-radius: 8px;
                        background: th-ta.has-hover ? Theme.hover : transparent;
                        th-ta := TouchArea { }
                        HorizontalLayout {
                            padding-left: 10px;
                            padding-right: 10px;
                            spacing: 12px;
                            VerticalLayout {
                                alignment: center;
                                horizontal-stretch: 1;
                                Text {
                                    text: "Theme";
                                    font-size: 13px;
                                    font-weight: 500;
                                    color: Theme.text;
                                }
                                Text {
                                    text: Theme.names[root.theme-hover >= 0 ? root.theme-hover : Theme.palette];
                                    font-size: 12px;
                                    color: Theme.text2;
                                }
                            }
                            VerticalLayout {
                                alignment: center;
                                HorizontalLayout {
                                    spacing: 8px;
                                    ThemeChip {
                                        index: 0;
                                        selected: Theme.palette == 0;
                                        picked => {
                                            Theme.palette = 0;
                                            root.set-theme(0);
                                        }
                                        hovered(on) => {
                                            root.theme-hover = on ? 0 : -1;
                                        }
                                    }
                                    for n[i] in 6: ThemeChip {
                                        index: i + 1;
                                        selected: Theme.palette == i + 1;
                                        picked => {
                                            Theme.palette = i + 1;
                                            root.set-theme(i + 1);
                                        }
                                        hovered(on) => {
                                            root.theme-hover = on ? i + 1 : -1;
                                        }
                                    }
                                }
                            }
                        }
                    }
                    Rectangle {
                        height: 64px;
                        border-radius: 8px;
                        background: ca-ta.has-hover ? Theme.hover : transparent;
                        ca-ta := TouchArea { }
                        HorizontalLayout {
                            padding-left: 10px;
                            padding-right: 10px;
                            spacing: 12px;
                            VerticalLayout {
                                alignment: center;
                                horizontal-stretch: 1;
                                Text {
                                    text: "Audio cache";
                                    font-size: 13px;
                                    font-weight: 500;
                                    color: Theme.text;
                                }
                                Text {
                                    text: root.cache-text;
                                    font-size: 12px;
                                    color: Theme.text2;
                                }
                            }
                            VerticalLayout {
                                alignment: center;
                                TextButton {
                                    label: "Clear";
                                    clicked => {
                                        root.clear-cache();
                                    }
                                }
                            }
                        }
                    }
                    Rectangle {
                        height: 64px;
                        border-radius: 8px;
                        background: yt-ta.has-hover ? Theme.hover : transparent;
                        yt-ta := TouchArea { }
                        HorizontalLayout {
                            padding-left: 10px;
                            padding-right: 10px;
                            spacing: 12px;
                            VerticalLayout {
                                alignment: center;
                                horizontal-stretch: 1;
                                Text {
                                    text: "yt-dlp";
                                    font-size: 13px;
                                    font-weight: 500;
                                    color: Theme.text;
                                }
                                Text {
                                    text: root.ytdlp-note != "" ? root.ytdlp-note : (root.ytdlp-version != "" ? "Version " + root.ytdlp-version : "Checking version…");
                                    font-size: 12px;
                                    color: Theme.text2;
                                    wrap: word-wrap;
                                }
                            }
                            VerticalLayout {
                                alignment: center;
                                TextButton {
                                    label: root.ytdlp-updating ? "Updating…" : "Update";
                                    clicked => {
                                        root.update-ytdlp();
                                    }
                                }
                            }
                        }
                    }
                    Rectangle {
                        height: 64px;
                        border-radius: 8px;
                        background: ac-ta.has-hover ? Theme.hover : transparent;
                        ac-ta := TouchArea { }
                        HorizontalLayout {
                            padding-left: 10px;
                            padding-right: 10px;
                            spacing: 12px;
                            VerticalLayout {
                                alignment: center;
                                horizontal-stretch: 1;
                                Text {
                                    text: "Account";
                                    font-size: 13px;
                                    font-weight: 500;
                                    color: Theme.text;
                                }
                                Text {
                                    text: root.signed-in ? "Signed in with Google" : "Not signed in";
                                    font-size: 12px;
                                    color: Theme.text2;
                                }
                            }
                            if root.signed-in: VerticalLayout {
                                alignment: center;
                                TextButton {
                                    label: "Sign out";
                                    clicked => {
                                        root.sign-out();
                                    }
                                }
                            }
                        }
                    }
                    Rectangle {
                        height: 64px;
                        border-radius: 8px;
                        background: nm-ta.has-hover ? Theme.hover : transparent;
                        nm-ta := TouchArea { }
                        HorizontalLayout {
                            padding-left: 10px;
                            padding-right: 10px;
                            spacing: 12px;
                            VerticalLayout {
                                alignment: center;
                                horizontal-stretch: 1;
                                Text {
                                    text: "Display name";
                                    font-size: 13px;
                                    font-weight: 500;
                                    color: Theme.text;
                                }
                                Text {
                                    text: "Shown to everyone in a party";
                                    font-size: 12px;
                                    color: Theme.text2;
                                }
                            }
                            VerticalLayout {
                                alignment: center;
                                TextField {
                                    min-width: 220px;
                                    max-width: 220px;
                                    text <=> root.display-name;
                                    placeholder: "Your name";
                                    edited(t) => {
                                        root.display-name-edited(t);
                                    }
                                }
                            }
                        }
                    }
                    Rectangle {
                        height: 64px;
                        border-radius: 8px;
                        background: sv-ta.has-hover ? Theme.hover : transparent;
                        sv-ta := TouchArea { }
                        HorizontalLayout {
                            padding-left: 10px;
                            padding-right: 10px;
                            spacing: 12px;
                            VerticalLayout {
                                alignment: center;
                                horizontal-stretch: 1;
                                Text {
                                    text: "Party server";
                                    font-size: 13px;
                                    font-weight: 500;
                                    color: Theme.text;
                                }
                                Text {
                                    text: root.party-server-built-in ? "Advanced. Leave empty to use the built-in server" : "The relay everyone in a party connects through";
                                    font-size: 12px;
                                    color: Theme.text2;
                                }
                            }
                            VerticalLayout {
                                alignment: center;
                                TextField {
                                    min-width: 220px;
                                    max-width: 220px;
                                    text <=> root.party-server;
                                    placeholder: root.party-server-built-in ? "Built-in server" : "wss://your-relay.example.com";
                                    edited(t) => {
                                        root.party-server-edited(t);
                                    }
                                }
                            }
                        }
                    }
                    }
                }
                }
                if root.artist-open && !root.settings-open: VerticalLayout {
                    spacing: 10px;
                    vertical-stretch: 1;
                    HorizontalLayout {
                        height: 30px;
                        TextButton {
                            label: "Back";
                            clicked => {
                                root.artist-back();
                            }
                        }
                        Rectangle {
                            horizontal-stretch: 1;
                        }
                    }
                    HorizontalLayout {
                        height: 72px;
                        spacing: 14px;
                        VerticalLayout {
                            alignment: center;
                            Rectangle {
                                min-width: 72px;
                                max-width: 72px;
                                min-height: 72px;
                                max-height: 72px;
                                border-radius: 8px;
                                background: Theme.border;
                                clip: true;
                                if root.artist-image.width > 0 && !Theme.perf: Image {
                                    source: root.artist-image;
                                    width: parent.width;
                                    height: parent.height;
                                }
                                if root.artist-image.width == 0 || Theme.perf: Icon {
                                    glyph: Glyphs.music;
                                    tint: Theme.text3;
                                    width: 26px;
                                    height: 26px;
                                    x: (parent.width - self.width) / 2;
                                    y: (parent.height - self.height) / 2;
                                }
                            }
                        }
                        VerticalLayout {
                            alignment: center;
                            horizontal-stretch: 1;
                            spacing: 2px;
                            Text {
                                text: root.artist-name;
                                font-size: 20px;
                                font-weight: 500;
                                color: Theme.text;
                                overflow: elide;
                            }
                            Text {
                                text: root.artist-sub;
                                font-size: 12px;
                                color: Theme.text2;
                                overflow: elide;
                            }
                            HorizontalLayout {
                                padding-top: 6px;
                                spacing: 8px;
                                TextButton {
                                    label: "Play all";
                                    primary: true;
                                    clicked => {
                                        root.play-all();
                                    }
                                }
                                TextButton {
                                    label: "Add all";
                                    clicked => {
                                        root.add-all();
                                    }
                                }
                                Rectangle {
                                    horizontal-stretch: 1;
                                }
                            }
                        }
                    }
                    Rectangle {
                        vertical-stretch: 1;
                        ScrollList {
                            VerticalLayout {
                                spacing: 2px;
                                alignment: start;
                                if root.playlist-tracks.length > 0: Text {
                                    text: root.artist-album ? "Tracks" : "Top songs";
                                    font-size: 12px;
                                    font-weight: 500;
                                    color: Theme.text2;
                                    height: 26px;
                                    vertical-alignment: center;
                                }
                                for item[i] in root.playlist-tracks: TrackRow {
                                    menu: true;
                                    menu-add: true;
                                    menu-play-next => {
                                        root.play-next-playlist-track(i);
                                    }
                                    menu-add-clicked => {
                                        root.add-playlist-track(i);
                                    }
                                    menu-copy-link(url) => {
                                        root.copy-text(url);
                                    }
                                    menu-open-web(id) => {
                                        root.open-track-web(id);
                                    }
                                    item: item;
                                    action-glyph: Glyphs.plus;
                                    action-tip: "Add to queue";
                                    hover-intent => {
                                        root.prefetch-playlist-track(i);
                                    }
                                    activated => {
                                        root.play-playlist-track(i);
                                    }
                                    action => {
                                        root.add-playlist-track(i);
                                    }
                                    artist-clicked(id) => {
                                        root.open-artist(id);
                                    }
                                }
                                if root.artist-albums.length > 0 && !root.artist-album: Text {
                                    text: "Albums and singles";
                                    font-size: 12px;
                                    font-weight: 500;
                                    color: Theme.text2;
                                    height: 40px;
                                    vertical-alignment: bottom;
                                }
                                if !root.artist-album: VerticalLayout {
                                    spacing: 2px;
                                    for item[i] in root.artist-albums: TrackRow {
                                        item: item;
                                        playable: false;
                                        activated => {
                                            root.open-album(i);
                                        }
                                    }
                                }
                            }
                        }
                        if root.artist-loading || root.artist-note != "": Text {
                            text: root.artist-loading ? "Loading…" : root.artist-note;
                            color: Theme.text3;
                            font-size: 14px;
                            wrap: word-wrap;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }
                }
                if !root.settings-open && !root.artist-open && root.tab == 0: VerticalLayout {
                    spacing: 10px;
                    vertical-stretch: 1;
                    Rectangle {
                        height: 38px;
                        border-radius: 8px;
                        border-width: 1px;
                        border-color: input.has-focus ? Theme.accent : Theme.border;
                        background: Theme.surface;
                        Icon {
                            glyph: Glyphs.search;
                            tint: Theme.text3;
                            x: 10px;
                            y: (parent.height - self.height) / 2;
                            width: 18px;
                            height: 18px;
                        }
                        if root.query == "": Text {
                            text: "Search songs, artists, albums";
                            color: Theme.text3;
                            font-size: 14px;
                            x: 36px;
                            y: (parent.height - self.height) / 2;
                        }
                        input := TextInput {
                            text <=> root.query;
                            x: 36px;
                            y: 0px;
                            height: parent.height;
                            vertical-alignment: center;
                            width: parent.width - 48px;
                            font-size: 14px;
                            color: Theme.text;
                            accepted => {
                                root.search(root.query);
                                // hand the keyboard back, so Space and the arrows work on the results
                                fs.focus();
                            }
                        }
                        Timer {
                            interval: 60ms;
                            running: root.want-search-focus;
                            triggered => {
                                root.want-search-focus = false;
                                input.focus();
                                // so the next thing typed replaces the old search
                                input.select-all();
                            }
                        }
                    }
                    Rectangle {
                        vertical-stretch: 1;
                        ScrollList {
                            VerticalLayout {
                                spacing: 2px;
                                alignment: start;
                                for item[i] in root.results: TrackRow {
                                    menu: true;
                                    menu-add: true;
                                    menu-play-next => {
                                        root.play-next-result(i);
                                    }
                                    menu-add-clicked => {
                                        root.add-result(i);
                                    }
                                    menu-copy-link(url) => {
                                        root.copy-text(url);
                                    }
                                    menu-open-web(id) => {
                                        root.open-track-web(id);
                                    }
                                    artist-clicked(id) => {
                                        root.open-artist(id);
                                    }
                                    item: item;
                                    action-glyph: Glyphs.plus;
                                    action-tip: "Add to queue";
                                    hover-intent => {
                                        root.prefetch-result(i);
                                    }
                                    activated => {
                                        root.play-result(i);
                                    }
                                    action => {
                                        root.add-result(i);
                                    }
                                }
                            }
                        }
                        if root.results.length == 0: Text {
                            text: root.searching ? "Searching…" : (root.search-note != "" ? root.search-note : "Search for something to play");
                            color: Theme.text3;
                            font-size: 14px;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }
                }
                if !root.settings-open && !root.artist-open && root.tab == 1 && !root.signed-in: VerticalLayout {
                    vertical-stretch: 1;
                    alignment: center;
                    spacing: 12px;
                    Text {
                        text: "Sign in to see your library";
                        color: Theme.text;
                        font-size: 16px;
                        font-weight: 500;
                        horizontal-alignment: center;
                    }
                    Text {
                        text: "A Google sign-in window opens inside the app. Your password goes to Google's own page and is never seen by this app.";
                        color: Theme.text2;
                        font-size: 12px;
                        wrap: word-wrap;
                        horizontal-alignment: center;
                    }
                    HorizontalLayout {
                        alignment: center;
                        TextButton {
                            label: root.signing-in ? "Signing in…" : "Sign in with Google";
                            primary: true;
                            clicked => {
                                root.sign-in-google();
                            }
                        }
                    }
                    Text {
                        text: root.auth-note;
                        color: Theme.danger;
                        font-size: 12px;
                        wrap: word-wrap;
                        horizontal-alignment: center;
                    }
                    Text {
                        text: "Or import a cookies.txt file, or type a browser name (firefox, brave, chrome, edge)";
                        color: Theme.text3;
                        font-size: 12px;
                        wrap: word-wrap;
                        horizontal-alignment: center;
                    }
                    HorizontalLayout {
                        spacing: 8px;
                        Rectangle {
                            height: 34px;
                            horizontal-stretch: 1;
                            border-radius: 8px;
                            border-width: 1px;
                            border-color: signin-field.has-focus ? Theme.accent : Theme.border;
                            background: Theme.surface;
                            if root.signin-input == "": Text {
                                text: "C:\\path\\to\\cookies.txt  or  firefox";
                                color: Theme.text3;
                                font-size: 13px;
                                x: 12px;
                                y: (parent.height - self.height) / 2;
                            }
                            signin-field := TextInput {
                                text <=> root.signin-input;
                                x: 12px;
                                y: 0px;
                                height: parent.height;
                                vertical-alignment: center;
                                width: parent.width - 24px;
                                font-size: 13px;
                                color: Theme.text;
                                accepted => {
                                    root.sign-in(root.signin-input);
                                }
                            }
                        }
                        VerticalLayout {
                            alignment: center;
                            TextButton {
                                label: "Import";
                                clicked => {
                                    root.sign-in(root.signin-input);
                                }
                            }
                        }
                    }
                }
                if !root.settings-open && !root.artist-open && root.tab == 1 && root.signed-in && !root.in-playlist: VerticalLayout {
                    spacing: 10px;
                    vertical-stretch: 1;
                    HorizontalLayout {
                        height: 26px;
                        spacing: 8px;
                        Text {
                            text: "Your playlists";
                            color: Theme.text2;
                            font-size: 12px;
                            font-weight: 500;
                            vertical-alignment: center;
                            horizontal-stretch: 1;
                        }
                        IconButton {
                            glyph: Glyphs.refresh;
                            size: 26px;
                            tip: "Refresh";
                            tip-below: true;
                            clicked => {
                                root.refresh-library();
                            }
                        }
                        TextLink {
                            label: "Sign out";
                            clicked => {
                                root.sign-out();
                            }
                        }
                    }
                    Rectangle {
                        vertical-stretch: 1;
                        ScrollList {
                            VerticalLayout {
                                spacing: 2px;
                                alignment: start;
                                for item[i] in root.playlists: TrackRow {
                                    item: item;
                                    playable: false;
                                    activated => {
                                        root.in-playlist = true;
                                        root.open-playlist(i);
                                    }
                                }
                            }
                        }
                        if root.playlists.length == 0: Text {
                            text: root.library-loading ? "Loading your library…" : (root.library-note != "" ? root.library-note : "No playlists found");
                            color: Theme.text3;
                            font-size: 14px;
                            wrap: word-wrap;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }
                }
                if !root.settings-open && !root.artist-open && root.tab == 1 && root.signed-in && root.in-playlist: VerticalLayout {
                    spacing: 10px;
                    vertical-stretch: 1;
                    HorizontalLayout {
                        height: 30px;
                        spacing: 10px;
                        TextButton {
                            label: "Back";
                            clicked => {
                                root.in-playlist = false;
                            }
                        }
                        Text {
                            text: root.playlist-title;
                            color: Theme.text;
                            font-size: 14px;
                            font-weight: 500;
                            vertical-alignment: center;
                            overflow: elide;
                            horizontal-stretch: 1;
                        }
                        TextButton {
                            label: "Play all";
                            primary: true;
                            clicked => {
                                root.play-all();
                            }
                        }
                        TextButton {
                            label: "Add all";
                            clicked => {
                                root.add-all();
                            }
                        }
                    }
                    Rectangle {
                        vertical-stretch: 1;
                        ScrollList {
                            VerticalLayout {
                                spacing: 2px;
                                alignment: start;
                                for item[i] in root.playlist-tracks: TrackRow {
                                    menu: true;
                                    menu-add: true;
                                    menu-play-next => {
                                        root.play-next-playlist-track(i);
                                    }
                                    menu-add-clicked => {
                                        root.add-playlist-track(i);
                                    }
                                    menu-copy-link(url) => {
                                        root.copy-text(url);
                                    }
                                    menu-open-web(id) => {
                                        root.open-track-web(id);
                                    }
                                    artist-clicked(id) => {
                                        root.open-artist(id);
                                    }
                                    item: item;
                                    action-glyph: Glyphs.plus;
                                    action-tip: "Add to queue";
                                    hover-intent => {
                                        root.prefetch-playlist-track(i);
                                    }
                                    activated => {
                                        root.play-playlist-track(i);
                                    }
                                    action => {
                                        root.add-playlist-track(i);
                                    }
                                }
                            }
                        }
                        if root.playlist-tracks.length == 0: Text {
                            text: root.playlist-loading ? "Loading…" : (root.playlist-note != "" ? root.playlist-note : "This playlist is empty");
                            color: Theme.text3;
                            font-size: 14px;
                            wrap: word-wrap;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }
                }
                if !root.settings-open && !root.artist-open && root.tab == 2: VerticalLayout {
                    spacing: 8px;
                    vertical-stretch: 1;
                    HorizontalLayout {
                        height: 20px;
                        Text {
                            text: root.now-title;
                            color: Theme.text2;
                            font-size: 12px;
                            font-weight: 500;
                            vertical-alignment: center;
                            overflow: elide;
                            horizontal-stretch: 1;
                        }
                        Text {
                            text: root.lyrics-source;
                            color: Theme.text3;
                            font-size: 11px;
                            vertical-alignment: center;
                            horizontal-alignment: right;
                        }
                    }
                    Rectangle {
                        vertical-stretch: 1;
                        property <int> now: root.lyrics-current;
                        property <int> count: root.lyrics-lines.length;
                        changed now => {
                            lyric-list.scroll-center(root.lyrics-current * 36px + 18px);
                        }
                        changed count => {
                            lyric-list.scroll-center(0px);
                        }
                        lyric-list := ScrollList {
                            VerticalLayout {
                                alignment: start;
                                for line[i] in root.lyrics-lines: LyricRow {
                                    line: line;
                                    current: root.lyrics-synced && i == root.lyrics-current;
                                    seekable: root.lyrics-synced;
                                    activated => {
                                        root.seek-lyric(line.time);
                                    }
                                }
                            }
                        }
                        if root.lyrics-lines.length == 0: Text {
                            text: root.lyrics-loading ? "Looking for lyrics…" : (root.lyrics-note != "" ? root.lyrics-note : "Play a song to see its lyrics");
                            color: Theme.text3;
                            font-size: 14px;
                            wrap: word-wrap;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }
                }
                if !root.settings-open && !root.artist-open && root.tab == 3: VerticalLayout {
                    spacing: 12px;
                    vertical-stretch: 1;
                    alignment: start;
                    if root.party-note != "": Text {
                        text: root.party-note;
                        color: Theme.danger;
                        font-size: 12px;
                        wrap: word-wrap;
                    }
                    if root.party-mode == 0 && !root.party-server-ready: Rectangle {
                        height: 72px;
                        border-radius: 12px;
                        background: Theme.accent-bg;
                        HorizontalLayout {
                            padding: 14px;
                            spacing: 12px;
                            VerticalLayout {
                                alignment: center;
                                horizontal-stretch: 1;
                                Text {
                                    text: "Add a party server first";
                                    font-size: 13px;
                                    font-weight: 500;
                                    color: Theme.text;
                                }
                                Text {
                                    text: "Parties connect through a small relay server. Paste its address in Settings.";
                                    font-size: 12px;
                                    color: Theme.text2;
                                    wrap: word-wrap;
                                }
                            }
                            VerticalLayout {
                                alignment: center;
                                TextButton {
                                    label: "Open settings";
                                    clicked => {
                                        root.settings-open = true;
                                        root.view-changed(-1);
                                    }
                                }
                            }
                        }
                    }
                    if root.party-mode == 0: Card {
                        height: 116px;
                        Text {
                            text: "Start a party";
                            font-size: 14px;
                            font-weight: 500;
                            color: Theme.text;
                        }
                        Text {
                            text: "You choose what plays. Friends who join hear it at the same moment.";
                            font-size: 12px;
                            color: Theme.text2;
                            wrap: word-wrap;
                        }
                        HorizontalLayout {
                            padding-top: 6px;
                            TextButton {
                                label: "Start a party";
                                primary: true;
                                clicked => {
                                    root.party-start();
                                }
                            }
                            Rectangle {
                                horizontal-stretch: 1;
                            }
                        }
                    }
                    if root.party-mode == 0: Card {
                        height: 128px;
                        Text {
                            text: "Join a party";
                            font-size: 14px;
                            font-weight: 500;
                            color: Theme.text;
                        }
                        Text {
                            text: "Enter the code the host shares with you.";
                            font-size: 12px;
                            color: Theme.text2;
                        }
                        HorizontalLayout {
                            padding-top: 6px;
                            spacing: 8px;
                            TextField {
                                horizontal-stretch: 1;
                                text <=> root.party-code-input;
                                placeholder: "Party code";
                                accepted(t) => {
                                    root.party-join(t);
                                }
                            }
                            VerticalLayout {
                                alignment: center;
                                TextButton {
                                    label: "Join";
                                    clicked => {
                                        root.party-join(root.party-code-input);
                                    }
                                }
                            }
                        }
                    }
                    if root.party-mode > 0 && root.party-connecting: Text {
                        text: "Connecting to the party server…";
                        color: Theme.text3;
                        font-size: 13px;
                    }
                    if root.party-mode == 2 && !root.party-connecting: Rectangle {
                        height: 36px;
                        border-radius: 8px;
                        background: Theme.accent-bg;
                        Text {
                            text: root.party-control ? "Listening with " + root.party-host-name + ". Everyone can control playback." : "Listening with " + root.party-host-name + ". Only the host controls playback.";
                            color: Theme.accent;
                            font-size: 12px;
                            x: 12px;
                            width: parent.width - 24px;
                            vertical-alignment: center;
                            overflow: elide;
                        }
                    }
                    if root.party-mode > 0 && !root.party-connecting: Card {
                        height: root.party-mode == 1 ? 140px : 96px;
                        property <bool> copied;
                        Timer {
                            interval: 1500ms;
                            running: copied;
                            triggered => {
                                copied = false;
                            }
                        }
                        if root.party-mode == 1: Text {
                            text: "Your party code";
                            font-size: 12px;
                            color: Theme.text2;
                        }
                        if root.party-mode == 1: Text {
                            text: root.party-room;
                            font-size: 30px;
                            font-weight: 500;
                            font-family: "Consolas";
                            letter-spacing: 4px;
                            color: Theme.text;
                        }
                        if root.party-mode == 2: Text {
                            text: root.party-host-name + "'s party";
                            font-size: 14px;
                            font-weight: 500;
                            color: Theme.text;
                        }
                        if root.party-mode == 2: Text {
                            text: "Code \{root.party-room} · \{root.party-members.length} listening\{root.party-sync != "" ? " · " + root.party-sync : ""}";
                            font-size: 12px;
                            color: Theme.text2;
                        }
                        HorizontalLayout {
                            padding-top: 4px;
                            spacing: 8px;
                            if root.party-mode == 1: TextButton {
                                label: copied ? "Copied" : "Copy code";
                                clicked => {
                                    root.copy-text(root.party-room);
                                    copied = true;
                                }
                            }
                            TextButton {
                                label: root.party-mode == 1 ? "End party" : "Leave party";
                                danger: true;
                                clicked => {
                                    root.party-leave();
                                }
                            }
                            Rectangle {
                                horizontal-stretch: 1;
                            }
                        }
                    }
                    if root.party-mode == 1 && !root.party-connecting: Rectangle {
                        height: 52px;
                        border-radius: 8px;
                        background: pc-ta.has-hover ? Theme.hover : transparent;
                        pc-ta := TouchArea { }
                        HorizontalLayout {
                            padding-left: 10px;
                            padding-right: 10px;
                            spacing: 12px;
                            VerticalLayout {
                                alignment: center;
                                horizontal-stretch: 1;
                                Text {
                                    text: "Everyone can control";
                                    font-size: 13px;
                                    font-weight: 500;
                                    color: Theme.text;
                                }
                                Text {
                                    text: "Guests can play, pause, skip, seek and add songs";
                                    font-size: 12px;
                                    color: Theme.text2;
                                    overflow: elide;
                                }
                            }
                            VerticalLayout {
                                alignment: center;
                                Toggle {
                                    checked: root.party-control;
                                    toggled(on) => {
                                        root.party-control-changed(on);
                                    }
                                }
                            }
                        }
                    }
                    if root.party-mode > 0 && !root.party-connecting: VerticalLayout {
                        spacing: 2px;
                        Text {
                            text: "Listening now · \{root.party-members.length}";
                            font-size: 12px;
                            color: Theme.text2;
                        }
                        for m in root.party-members: Rectangle {
                            height: 40px;
                            border-radius: 8px;
                            background: m-ta.has-hover ? Theme.hover : transparent;
                            m-ta := TouchArea { }
                            HorizontalLayout {
                                padding-left: 8px;
                                padding-right: 8px;
                                spacing: 10px;
                                VerticalLayout {
                                    alignment: center;
                                    Rectangle {
                                        min-width: 28px;
                                        max-width: 28px;
                                        min-height: 28px;
                                        max-height: 28px;
                                        border-radius: 14px;
                                        background: Theme.accent-bg;
                                        Text {
                                            text: m.initial;
                                            color: Theme.accent;
                                            font-size: 12px;
                                            font-weight: 500;
                                            horizontal-alignment: center;
                                            vertical-alignment: center;
                                        }
                                    }
                                }
                                Text {
                                    text: m.name;
                                    font-size: 13px;
                                    color: Theme.text;
                                    vertical-alignment: center;
                                    horizontal-stretch: 1;
                                    overflow: elide;
                                }
                                if m.tag != "": VerticalLayout {
                                    alignment: center;
                                    Rectangle {
                                        min-width: pill-text.preferred-width + 16px;
                                        max-width: pill-text.preferred-width + 16px;
                                        height: 20px;
                                        border-radius: 10px;
                                        background: m.tag == "In sync" ? Theme.success-bg : (m.tag == "Host" ? Theme.accent-bg : Theme.surface);
                                        pill-text := Text {
                                            text: m.tag;
                                            font-size: 11px;
                                            color: m.tag == "In sync" ? Theme.success : (m.tag == "Host" ? Theme.accent : Theme.text2);
                                            horizontal-alignment: center;
                                            vertical-alignment: center;
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
            Rectangle {
                width: 1px;
                background: Theme.border;
            }
            VerticalLayout {
                padding: 14px;
                spacing: 10px;
                min-width: 270px;
                max-width: 270px;
                HorizontalLayout {
                    height: 22px;
                    Text {
                        text: "Up next";
                        color: Theme.text2;
                        font-size: 12px;
                        font-weight: 500;
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                    }
                    if root.queue.length > 0: TextLink {
                        label: "Clear";
                        clicked => {
                            root.clear-queue();
                        }
                    }
                }
                Rectangle {
                    vertical-stretch: 1;
                    ScrollList {
                        VerticalLayout {
                            spacing: 2px;
                            alignment: start;
                            for item[i] in root.queue: TrackRow {
                                menu: true;
                                menu-remove: true;
                                menu-play-next => {
                                    root.play-next-queue(i);
                                }
                                menu-remove-clicked => {
                                    root.remove-queue(i);
                                }
                                menu-copy-link(url) => {
                                    root.copy-text(url);
                                }
                                menu-open-web(id) => {
                                    root.open-track-web(id);
                                }
                                artist-clicked(id) => {
                                    root.open-artist(id);
                                }
                                item: item;
                                current: i == root.current-index;
                                draggable: !root.controls-locked;
                                line-top: root.drag-to == i && root.drag-to < root.drag-from;
                                line-bottom: root.drag-to == i && root.drag-to > root.drag-from;
                                drag-update(dy) => {
                                    root.drag-from = i;
                                    // rows are 48px tall with 2px between them
                                    root.drag-to = Math.max(0, Math.min(root.queue.length - 1, i + Math.round(dy / 50px)));
                                }
                                drag-finish => {
                                    if (root.drag-from >= 0 && root.drag-to != root.drag-from) {
                                        root.move-queue(root.drag-from, root.drag-to);
                                    }
                                    root.drag-from = -1;
                                    root.drag-to = -1;
                                }
                                action-glyph: Glyphs.close;
                                action-tip: "Remove";
                                hover-intent => {
                                    root.prefetch-queue(i);
                                }
                                activated => {
                                    root.play-queue(i);
                                }
                                action => {
                                    root.remove-queue(i);
                                }
                            }
                        }
                    }
                    if root.queue.length == 0: Text {
                        text: "Your queue is empty.\nAdd tracks with +";
                        color: Theme.text3;
                        font-size: 13px;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
            }
        }
        Rectangle {
            height: 1px;
            background: Theme.border;
        }
        Rectangle {
            height: 76px;
            background: Theme.surface;
            HorizontalLayout {
                padding-left: 14px;
                padding-right: 16px;
                spacing: 12px;
                VerticalLayout {
                    alignment: center;
                    Rectangle {
                        min-width: 48px;
                        max-width: 48px;
                        min-height: 48px;
                        max-height: 48px;
                        border-radius: 6px;
                        background: Theme.accent-bg;
                        clip: true;
                        if root.now-cover.width > 0 && !Theme.perf: Image {
                            source: root.now-cover;
                            width: parent.width;
                            height: parent.height;
                        }
                        if root.now-cover.width == 0 || Theme.perf: Icon {
                            glyph: Glyphs.music;
                            tint: Theme.accent;
                            width: 22px;
                            height: 22px;
                            x: (parent.width - self.width) / 2;
                            y: (parent.height - self.height) / 2;
                        }
                    }
                }
                VerticalLayout {
                    alignment: center;
                    min-width: 150px;
                    max-width: 150px;
                    Text {
                        text: root.now-title;
                        color: Theme.text;
                        font-size: 13px;
                        font-weight: 500;
                        overflow: elide;
                    }
                    if root.now-artist-id == "": Text {
                        text: root.now-detail;
                        color: Theme.text2;
                        font-size: 12px;
                        overflow: elide;
                    }
                    if root.now-artist-id != "": CreditLine {
                        text: root.now-detail;
                        artist: root.now-artist;
                        rest: root.now-rest;
                        artist-id: root.now-artist-id;
                        artist-clicked(id) => {
                            root.open-artist(id);
                        }
                    }
                }
                VerticalLayout {
                    alignment: center;
                    HorizontalLayout {
                        spacing: 4px;
                        IconButton {
                            glyph: Glyphs.shuffle;
                            size: 32px;
                            tint: Theme.text3;
                            on: root.shuffle;
                            tip: root.shuffle ? "Shuffle on" : "Shuffle";
                            enabled: !root.controls-locked;
                            clicked => {
                                root.toggle-shuffle();
                            }
                        }
                        IconButton {
                            glyph: Glyphs.prev;
                            tip: "Previous (Ctrl+Left)";
                            enabled: !root.controls-locked;
                            clicked => {
                                root.prev();
                            }
                        }
                        IconButton {
                            glyph: (root.active && !root.paused) ? Glyphs.pause : Glyphs.play;
                            size: 44px;
                            solid: true;
                            tip: (root.active && !root.paused) ? "Pause (Space)" : "Play (Space)";
                            enabled: !root.controls-locked;
                            clicked => {
                                root.toggle-pause();
                            }
                        }
                        IconButton {
                            glyph: Glyphs.next;
                            tip: "Next (Ctrl+Right)";
                            enabled: !root.controls-locked;
                            clicked => {
                                root.next();
                            }
                        }
                        Rectangle {
                            min-width: 32px;
                            max-width: 32px;
                            IconButton {
                                glyph: Glyphs.repeat;
                                size: 32px;
                                tint: Theme.text3;
                                on: root.repeat-mode > 0;
                                tip: root.repeat-mode == 0 ? "Repeat" : (root.repeat-mode == 1 ? "Repeat all" : "Repeat one");
                                enabled: !root.controls-locked;
                                clicked => {
                                    root.cycle-repeat();
                                }
                            }
                            if root.repeat-mode == 2: Text {
                                text: "1";
                                color: Theme.accent;
                                font-size: 9px;
                                font-weight: 500;
                                x: (parent.width - self.width) / 2;
                                y: (parent.height - self.height) / 2 + 1px;
                            }
                        }
                    }
                }
                HorizontalLayout {
                    spacing: 8px;
                    horizontal-stretch: 1;
                    Text {
                        text: root.pos-text;
                        color: Theme.text3;
                        font-size: 11px;
                        vertical-alignment: center;
                        horizontal-alignment: right;
                        min-width: 36px;
                    }
                    VerticalLayout {
                        alignment: center;
                        horizontal-stretch: 1;
                        seek-bar := Scrub {
                            value: Math.min(Math.max(root.progress, 0), 1);
                            enabled: !root.controls-locked;
                            bubble: root.duration-secs > 0 ? root.clock(seek-bar.hover-fraction * root.duration-secs) : "";
                            committed(f) => {
                                root.seek(f);
                            }
                        }
                    }
                    Text {
                        text: root.dur-text;
                        color: Theme.text3;
                        font-size: 11px;
                        vertical-alignment: center;
                        min-width: 36px;
                    }
                }
                HorizontalLayout {
                    spacing: 6px;
                    min-width: 120px;
                    max-width: 120px;
                    VerticalLayout {
                        alignment: center;
                        Icon {
                            glyph: Glyphs.volume;
                            tint: Theme.text3;
                            width: 18px;
                            height: 18px;
                        }
                    }
                    VerticalLayout {
                        alignment: center;
                        horizontal-stretch: 1;
                        volume-bar := Scrub {
                            value: root.volume;
                            live: true;
                            bubble: "\{Math.round(volume-bar.hover-fraction * 100)}%";
                            committed(f) => {
                                root.volume = f;
                                root.set-volume(f);
                            }
                        }
                    }
                }
            }
        }
    }

    if TipState.shown && TipState.text != "": Rectangle {
        z: 100;
        property <length> tip-w: Math.min(tip-label.preferred-width, 320px) + 16px;
        width: self.tip-w;
        height: tip-label.preferred-height + 10px;
        x: Math.min(Math.max(TipState.x - self.tip-w / 2, 6px), root.width - self.tip-w - 6px);
        y: TipState.above ? TipState.y - self.height - 6px : TipState.y + 6px;
        border-radius: 5px;
        background: Theme.text;
        tip-label := Text {
            text: TipState.text;
            color: Theme.bg;
            font-size: 11px;
            wrap: word-wrap;
            x: 8px;
            y: 5px;
            width: parent.width - 16px;
        }
    }
    }
}
