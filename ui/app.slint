component Icon inherits Path {
    in property <string> glyph;
    in property <color> tint: Theme.text;
    viewbox-width: 24;
    viewbox-height: 24;
    commands: root.glyph;
    fill: root.tint;
}

/// Shows a tooltip after the mouse has rested on the parent for a moment.
/// Place it inside the element to describe, at the point the tooltip should point to.
component HoverTip inherits Rectangle {
    in property <bool> hovering;
    in property <string> text;
    in property <duration> delay: 500ms;
    in property <bool> above: true;
    /// Set by the parent on click so the tooltip doesn't pop up right after the click
    in-out property <bool> fired;
    width: 0px;
    height: 0px;
    Timer {
        interval: root.delay;
        running: root.hovering && !root.fired && root.text != "";
        triggered => {
            root.fired = true;
            TipState.text = root.text;
            TipState.x = root.absolute-position.x;
            TipState.y = root.absolute-position.y;
            TipState.above = root.above;
            TipState.shown = true;
        }
    }
    changed hovering => {
        if (!root.hovering) {
            root.fired = false;
            TipState.shown = false;
        }
    }
}

component IconButton inherits Rectangle {
    in property <string> glyph;
    in property <length> size: 36px;
    in property <color> tint: Theme.text2;
    /// Lit in the accent colour (shuffle or repeat switched on)
    in property <bool> on: false;
    in property <bool> solid: false;
    in property <string> tip;
    in property <bool> tip-below: false;
    /// Switched off while following a party host
    in property <bool> enabled: true;
    callback clicked;
    opacity: root.enabled ? 1 : 0.35;
    min-width: root.size;
    max-width: root.size;
    preferred-width: root.size;
    min-height: root.size;
    max-height: root.size;
    preferred-height: root.size;
    border-radius: root.size / 2;
    border-width: (ta.has-hover && !root.solid) ? 1px : 0px;
    border-color: Theme.border-strong;
    background: root.solid ? (ta.has-hover ? Theme.text.with-alpha(0.82) : Theme.text) : (ta.has-hover ? Theme.hover : transparent);
    animate background { duration: Theme.fade; }
    Icon {
        glyph: root.glyph;
        tint: root.solid ? Theme.bg : (root.on ? Theme.accent : (ta.has-hover ? Theme.text : root.tint));
        width: root.size * 0.56;
        height: root.size * 0.56;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
    }
    btn-tip := HoverTip {
        x: parent.width / 2;
        y: root.tip-below ? parent.height : 0px;
        above: !root.tip-below;
        hovering: ta.has-hover;
        text: root.tip;
    }
    ta := TouchArea {
        enabled: root.enabled;
        mouse-cursor: root.enabled ? MouseCursor.pointer : MouseCursor.not-allowed;
        clicked => {
            TipState.shown = false;
            btn-tip.fired = true;
            root.clicked();
        }
    }
}

component TabButton inherits Rectangle {
    in property <string> label;
    in property <bool> active;
    callback clicked;
    min-width: lbl.preferred-width;
    max-width: lbl.preferred-width;
    lbl := Text {
        text: root.label;
        font-size: 14px;
        font-weight: root.active ? 500 : 400;
        color: (root.active || ta.has-hover) ? Theme.text : Theme.text2;
        vertical-alignment: center;
    }
    Rectangle {
        y: parent.height - 2px;
        height: 2px;
        background: root.active ? Theme.accent : (ta.has-hover ? Theme.border-strong : transparent);
    }
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.clicked();
        }
    }
}

component TextButton inherits Rectangle {
    in property <string> label;
    in property <bool> primary: false;
    /// Red text, for actions like ending or leaving
    in property <bool> danger: false;
    callback clicked;
    min-width: t.preferred-width + 24px;
    max-width: t.preferred-width + 24px;
    height: 30px;
    border-radius: 6px;
    border-width: root.primary ? 0px : 1px;
    border-color: ta.has-hover ? Theme.text3 : Theme.border-strong;
    background: root.primary ? (ta.has-hover ? Theme.accent-fill.with-alpha(0.85) : Theme.accent-fill) : (ta.has-hover ? Theme.hover : transparent);
    animate background { duration: Theme.fade; }
    t := Text {
        text: root.label;
        font-size: 12px;
        font-weight: 500;
        color: root.primary ? #ffffff : (root.danger ? Theme.danger : Theme.text);
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.clicked();
        }
    }
}

component TextField inherits Rectangle {
    in-out property <string> text <=> input.text;
    in property <string> placeholder;
    callback edited(string);
    callback accepted(string);
    height: 34px;
    border-radius: 8px;
    border-width: 1px;
    border-color: input.has-focus ? Theme.accent : (hover-ta.has-hover ? Theme.border-strong : Theme.border);
    background: Theme.surface;
    hover-ta := TouchArea {
        mouse-cursor: MouseCursor.text;
    }
    if root.text == "": Text {
        text: root.placeholder;
        color: Theme.text3;
        font-size: 13px;
        x: 12px;
        y: (parent.height - self.height) / 2;
    }
    input := TextInput {
        x: 12px;
        y: 0px;
        width: parent.width - 24px;
        height: parent.height;
        vertical-alignment: center;
        font-size: 13px;
        color: Theme.text;
        edited => {
            root.edited(self.text);
        }
        accepted => {
            root.accepted(self.text);
        }
    }
}

/// A bordered panel; give it a height and put content inside
component Card inherits Rectangle {
    border-radius: 12px;
    border-width: 1px;
    border-color: card-ta.has-hover ? Theme.border-strong : Theme.border;
    card-ta := TouchArea { }
    VerticalLayout {
        padding: 14px;
        spacing: 6px;
        alignment: start;
        @children
    }
}

/// Small clickable text such as "Clear" or "Sign out"
component TextLink inherits Rectangle {
    in property <string> label;
    callback clicked;
    min-width: t.preferred-width;
    max-width: t.preferred-width;
    t := Text {
        text: root.label;
        font-size: 12px;
        color: ta.has-hover ? Theme.text : Theme.text2;
        vertical-alignment: center;
    }
    // Slint has no text underline, so draw one
    Rectangle {
        visible: ta.has-hover;
        x: 0px;
        y: (parent.height + t.preferred-height) / 2;
        width: t.preferred-width;
        height: 1px;
        background: Theme.text;
    }
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.clicked();
        }
    }
}

component Toggle inherits Rectangle {
    in-out property <bool> checked;
    callback toggled(bool);
    min-width: 40px;
    max-width: 40px;
    min-height: 24px;
    max-height: 24px;
    // hover ring, drawn outside the switch so it can't shift the knob
    Rectangle {
        x: -3px;
        y: -3px;
        width: parent.width + 6px;
        height: parent.height + 6px;
        border-radius: self.height / 2;
        border-width: 3px;
        border-color: ta.has-hover ? Theme.accent-bg : transparent;
    }
    Rectangle {
        border-radius: self.height / 2;
        background: root.checked ? Theme.accent-fill : Theme.border-strong;
        animate background { duration: Theme.fade; }
        // equal 3px margins at both ends
        Rectangle {
            width: 18px;
            height: 18px;
            border-radius: 9px;
            background: #ffffff;
            y: (parent.height - self.height) / 2;
            x: root.checked ? parent.width - self.width - 3px : 3px;
            animate x { duration: Theme.fade; }
        }
    }
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.checked = !root.checked;
            root.toggled(root.checked);
        }
    }
}

/// Scrolling list with a draggable scrollbar that grows when hovered
component ScrollList inherits Rectangle {
    property <bool> scrollable: fl.content-height > fl.height + 1px;
    property <length> thumb-h: Math.max(28px, fl.height * fl.height / Math.max(fl.content-height, 1px));
    /// Scrolls so the given content position is in the middle of the view
    public function scroll-center(y: length) {
        fl.content-y = -Math.max(0px, Math.min(y - fl.height / 2, fl.content-height - fl.height));
    }
    function drag-to(mouse-y: length) {
        if (root.scrollable) {
            fl.content-y = -Math.max(0.0, Math.min(1.0, (mouse-y - root.thumb-h / 2) / (root.height - root.thumb-h))) * (fl.content-height - fl.height);
        }
    }
    fl := Flickable {
        VerticalLayout {
            padding-right: 12px;
            @children
        }
    }
    Rectangle {
        visible: root.scrollable;
        width: (bar.has-hover || bar.pressed) ? 8px : 5px;
        height: root.thumb-h;
        x: parent.width - self.width - 2px;
        y: root.scrollable ? (-fl.content-y / (fl.content-height - fl.height)) * (parent.height - self.height) : 0px;
        border-radius: self.width / 2;
        background: (bar.has-hover || bar.pressed) ? Theme.text3 : Theme.border-strong;
        animate width { duration: Theme.fade; }
    }
    bar := TouchArea {
        x: parent.width - 14px;
        width: 14px;
        height: parent.height;
        mouse-cursor: pointer;
        enabled: root.scrollable;
        pointer-event(e) => {
            if (e.kind == PointerEventKind.down) {
                root.drag-to(self.mouse-y);
            }
        }
        moved => {
            if (self.pressed) {
                root.drag-to(self.mouse-y);
            }
        }
    }
}

/// Seek and volume bar: thickens, turns blue, shows a handle and a value bubble on hover
component Scrub inherits Rectangle {
    in property <float> value;
    /// Text for the bubble; the parent builds it from `hover-fraction`
    in property <string> bubble;
    /// Report the value continuously while dragging (volume) instead of on release (seek)
    in property <bool> live: false;
    /// Switched off while following a party host
    in property <bool> enabled: true;
    out property <float> hover-fraction: root.frac(ta.mouse-x);
    callback committed(float);
    opacity: root.enabled ? 1 : 0.45;
    property <bool> active: ta.has-hover || ta.pressed;
    property <float> shown: ta.pressed ? root.frac(ta.mouse-x) : root.value;
    height: 22px;
    pure function frac(x: length) -> float {
        return Math.max(0.0, Math.min(1.0, x / root.width));
    }
    track := Rectangle {
        y: (parent.height - self.height) / 2;
        height: root.active ? 6px : 4px;
        border-radius: self.height / 2;
        background: Theme.border-strong;
        animate height { duration: Theme.fade; }
        Rectangle {
            x: 0px;
            y: 0px;
            height: parent.height;
            width: parent.width * root.shown;
            border-radius: parent.border-radius;
            background: root.active ? Theme.accent : Theme.text2;
            animate background { duration: Theme.fade; }
        }
    }
    Rectangle {
        visible: root.active;
        width: 12px;
        height: 12px;
        border-radius: 6px;
        background: Theme.text;
        x: root.width * root.shown - 6px;
        y: (parent.height - 12px) / 2;
    }
    if root.active && root.bubble != "": Rectangle {
        width: bt.preferred-width + 14px;
        height: 20px;
        x: Math.min(Math.max(ta.mouse-x - self.width / 2, -30px), root.width - self.width + 30px);
        y: -26px;
        border-radius: 4px;
        background: Theme.text;
        bt := Text {
            text: root.bubble;
            color: Theme.bg;
            font-size: 11px;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }
    ta := TouchArea {
        enabled: root.enabled;
        mouse-cursor: root.enabled ? MouseCursor.pointer : MouseCursor.not-allowed;
        pointer-event(e) => {
            if (e.kind == PointerEventKind.down && root.live) {
                root.committed(root.frac(self.mouse-x));
            }
            if (e.kind == PointerEventKind.up && !root.live && e.button == PointerEventButton.left) {
                root.committed(root.frac(self.mouse-x));
            }
        }
        moved => {
            if (self.pressed && root.live) {
                root.committed(root.frac(self.mouse-x));
            }
        }
    }
}

/// "Artist · Album", where the artist's name opens their page when it can
component CreditLine inherits HorizontalLayout {
    in property <string> text;
    in property <string> artist;
    in property <string> rest;
    in property <string> artist-id;
    callback artist-clicked(string);
    preferred-height: 16px;
    spacing: 0px;
    if root.artist-id == "": Text {
        text: root.text;
        color: Theme.text2;
        font-size: 12px;
        overflow: elide;
        horizontal-stretch: 1;
    }
    if root.artist-id != "": Rectangle {
        preferred-width: at.preferred-width;
        min-width: 24px;
        horizontal-stretch: 0;
        at := Text {
            width: parent.width;
            text: root.artist;
            color: link-ta.has-hover ? Theme.accent : Theme.text2;
            font-size: 12px;
            overflow: elide;
        }
        Rectangle {
            visible: link-ta.has-hover;
            x: 0px;
            y: parent.height - 1px;
            height: 1px;
            width: Math.min(at.preferred-width, parent.width);
            background: Theme.accent;
        }
        link-ta := TouchArea {
            mouse-cursor: pointer;
            clicked => {
                root.artist-clicked(root.artist-id);
            }
        }
    }
    if root.artist-id != "": Text {
        text: root.rest != "" ? " · " + root.rest : "";
        color: Theme.text2;
        font-size: 12px;
        overflow: elide;
        horizontal-stretch: 1;
    }
}

component TrackRow inherits Rectangle {
    in property <TrackItem> item;
    callback artist-clicked(string);
    in property <bool> current: false;
    in property <string> action-glyph;
    in property <string> action-tip;
    /// Show a play icon over the cover while hovered (rows that start playback)
    in property <bool> playable: true;
    callback activated;
    callback action;
    /// The mouse has rested on this row, so it is probably about to be played
    callback hover-intent;
    property <bool> intent-sent;
    property <bool> hovering: row-ta.has-hover;
    property <bool> liked: root.item.id == "LM";
    /// Rows that can be dragged to another position (the queue)
    in property <bool> draggable: false;
    /// An insertion line along the top or bottom edge, shown on the row a drag would drop at
    in property <bool> line-top: false;
    in property <bool> line-bottom: false;
    /// How far the pointer has moved since the press, while this row is being dragged
    callback drag-update(length);
    callback drag-finish();
    property <bool> dragging;
    property <bool> was-dragged;
    /// Right-click menu entries. `menu` is off for rows that are not songs (playlists, albums).
    in property <bool> menu: false;
    in property <bool> menu-add: false;
    in property <bool> menu-remove: false;
    callback menu-play-next();
    callback menu-add-clicked();
    callback menu-remove-clicked();
    callback menu-copy-link(string);
    callback menu-open-web(string);
    height: 48px;
    border-radius: 8px;
    opacity: root.dragging ? 0.55 : 1;
    background: root.current ? Theme.accent-bg : (row-ta.has-hover ? Theme.hover : transparent);
    animate background { duration: Theme.fade; }
    row-ta := TouchArea {
        mouse-cursor: pointer;
        moved => {
            if (root.draggable && self.pressed) {
                // a few pixels of wobble during a click is not a drag
                if (root.dragging || Math.abs(self.mouse-y - self.pressed-y) > 6px) {
                    root.dragging = true;
                    root.drag-update(self.mouse-y - self.pressed-y);
                }
            }
        }
        pointer-event(e) => {
            if (e.kind == PointerEventKind.down) {
                root.was-dragged = false;
            }
            if (e.kind == PointerEventKind.up && root.dragging) {
                root.dragging = false;
                root.was-dragged = true;
                root.drag-finish();
            }
        }
        clicked => {
            if (root.was-dragged) {
                root.was-dragged = false;
                return;
            }
            TipState.shown = false;
            row-tip.fired = true;
            root.activated();
        }
    }
    Timer {
        interval: 400ms;
        running: root.hovering && !root.intent-sent;
        triggered => {
            root.intent-sent = true;
            root.hover-intent();
        }
    }
    changed hovering => {
        if (!root.hovering) {
            root.intent-sent = false;
        }
    }
    row-tip := HoverTip {
        x: 56px;
        y: parent.height;
        above: false;
        delay: 700ms;
        hovering: root.hovering;
        text: root.item.title + "\n" + root.item.channel;
    }
    HorizontalLayout {
        padding-left: 8px;
        padding-right: 6px;
        spacing: 10px;
        VerticalLayout {
            alignment: center;
            Rectangle {
                min-width: 36px;
                max-width: 36px;
                min-height: 36px;
                max-height: 36px;
                border-radius: 4px;
                background: root.liked ? Theme.danger.with-alpha(0.18) : Theme.border;
                clip: true;
                if !root.liked && root.item.thumb.width > 0 && !Theme.perf: Image {
                    source: root.item.thumb;
                    width: parent.width;
                    height: parent.height;
                }
                if root.liked: Icon {
                    glyph: Glyphs.heart;
                    tint: Theme.danger;
                    width: 18px;
                    height: 18px;
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                }
                if !root.liked && (root.item.thumb.width == 0 || Theme.perf): Icon {
                    glyph: Glyphs.music;
                    tint: Theme.text3;
                    width: 16px;
                    height: 16px;
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                }
                Rectangle {
                    background: #00000099;
                    opacity: (root.playable && root.hovering) ? 1 : 0;
                    animate opacity { duration: Theme.fade; }
                    Icon {
                        glyph: Glyphs.play;
                        tint: #ffffff;
                        width: 16px;
                        height: 16px;
                        x: (parent.width - self.width) / 2;
                        y: (parent.height - self.height) / 2;
                    }
                }
            }
        }
        VerticalLayout {
            alignment: center;
            horizontal-stretch: 1;
            Text {
                text: root.item.title;
                color: root.current ? Theme.accent : Theme.text;
                font-size: 13px;
                overflow: elide;
            }
            CreditLine {
                text: root.item.channel;
                artist: root.item.artist;
                rest: root.item.rest;
                artist-id: root.item.artist-id;
                artist-clicked(id) => {
                    TipState.shown = false;
                    row-tip.fired = true;
                    root.artist-clicked(id);
                }
            }
        }
        Text {
            text: root.item.duration;
            color: Theme.text3;
            font-size: 12px;
            vertical-alignment: center;
        }
        if root.action-glyph != "": VerticalLayout {
            alignment: center;
            IconButton {
                glyph: root.action-glyph;
                size: 30px;
                tip: root.action-tip;
                clicked => {
                    root.action();
                }
            }
        }
    }
    if root.menu: ContextMenuArea {
        Menu {
            MenuItem {
                title: "Play next";
                activated => {
                    root.menu-play-next();
                }
            }
            MenuItem {
                title: "Add to queue";
                enabled: root.menu-add;
                activated => {
                    root.menu-add-clicked();
                }
            }
            MenuItem {
                title: "Remove from queue";
                enabled: root.menu-remove;
                activated => {
                    root.menu-remove-clicked();
                }
            }
            MenuSeparator { }
            MenuItem {
                title: "Go to artist";
                enabled: root.item.artist-id != "";
                activated => {
                    root.artist-clicked(root.item.artist-id);
                }
            }
            MenuItem {
                title: "Copy link";
                activated => {
                    root.menu-copy-link("https://music.youtube.com/watch?v=" + root.item.id);
                }
            }
            MenuItem {
                title: "Open on YouTube Music";
                activated => {
                    root.menu-open-web(root.item.id);
                }
            }
        }
    }
    if root.line-top: Rectangle {
        y: -1px;
        height: 2px;
        width: parent.width;
        background: Theme.accent;
    }
    if root.line-bottom: Rectangle {
        y: parent.height - 1px;
        height: 2px;
        width: parent.width;
        background: Theme.accent;
    }
}

component LyricRow inherits Rectangle {
    in property <LyricLine> line;
    in property <bool> current;
    /// Synced lyrics can be clicked to jump to that line
    in property <bool> seekable;
    callback activated;
    height: 36px;
    border-radius: 8px;
    background: (root.seekable && ta.has-hover) ? Theme.hover : transparent;
    Text {
        text: root.line.text;
        color: root.current ? Theme.text : ((root.seekable && ta.has-hover) ? Theme.text : Theme.text3);
        font-size: root.current ? 17px : 15px;
        font-weight: root.current ? 500 : 400;
        horizontal-alignment: center;
        vertical-alignment: center;
        overflow: elide;
    }
    ta := TouchArea {
        enabled: root.seekable && root.line.text != "";
        mouse-cursor: pointer;
        clicked => {
            root.activated();
        }
    }
}

/// Hosts the embedded browser used to sign in to Google
export component LoginWindow inherits Window {
    title: "Sign in to YouTube Music";
    icon: @image-url("../assets/icon.png");
    background: Theme.bg;
    min-width: 480px;
    max-width: 480px;
    preferred-width: 480px;
    min-height: 720px;
    max-height: 720px;
    preferred-height: 720px;
}

export component MainWindow inherits Window {
    title: "ytmusic-lite";
    icon: @image-url("../assets/icon.png");
    min-width: 760px;
    min-height: 460px;
    preferred-width: 980px;
    preferred-height: 620px;
    background: Theme.bg;
    default-font-size: 13px;

    in-out property <string> query;
    in property <[TrackItem]> results;
    in property <[TrackItem]> queue;
    in property <int> current-index: -1;
    in property <bool> searching;
    in property <string> search-note;
    in property <string> now-title: "Nothing playing";
    in property <string> now-detail;
    /// `now-detail` split so the artist can be a link (empty while a status message shows)
    in property <string> now-artist;
    in property <string> now-rest;
    in property <string> now-artist-id;
    // artist pages. Their songs use `playlist-tracks`, so Play all and the row buttons work as in a playlist.
    in-out property <bool> artist-open;
    /// An album of the artist is open instead of the artist's own page
    in property <bool> artist-album;
    in property <bool> artist-loading;
    in property <string> artist-note;
    in property <string> artist-name;
    in property <string> artist-sub;
    in property <image> artist-image;
    in property <[TrackItem]> artist-albums;
    callback move-queue(int, int);
    callback seek-by(float);
    /// Set by the "/" shortcut: the search box takes the keyboard as soon as it is on screen
    property <bool> want-search-focus;
    callback play-next-result(int);
    callback play-next-playlist-track(int);
    callback play-next-queue(int);
    callback open-track-web(string);
    /// Queue row being dragged, and the row it would land on (-1 when no drag)
    property <int> drag-from: -1;
    property <int> drag-to: -1;
    callback open-artist(string);
    callback open-album(int);
    callback artist-back();
    callback close-artist();
    in property <image> now-cover;
    in property <string> pos-text: "0:00";
    in property <string> dur-text: "0:00";
    in property <float> duration-secs;
    in property <float> progress;
    in property <bool> active;
    in property <bool> paused;
    in property <bool> loading;
    in property <bool> shuffle;
    in property <int> repeat-mode;
    in-out property <float> volume: 0.8;

    // 0 = search, 1 = library, 2 = lyrics
    in-out property <int> tab;
    in-out property <bool> settings-open;
    in property <bool> signed-in;
    in property <bool> signing-in;
    in property <string> auth-note;
    in-out property <string> signin-input;
    in property <[TrackItem]> playlists;
    in property <bool> library-loading;
    in property <string> library-note;
    in-out property <bool> in-playlist;
    in property <string> playlist-title;
    in property <[TrackItem]> playlist-tracks;
    in property <bool> playlist-loading;
    in property <string> playlist-note;

    in property <[LyricLine]> lyrics-lines;
    in property <bool> lyrics-synced;
    in property <int> lyrics-current: -1;
    in property <string> lyrics-source;
    in property <bool> lyrics-loading;
    in property <string> lyrics-note;

    in-out property <bool> perf-mode;
    in property <string> cache-text: "Calculating…";
    in property <string> ytdlp-version;
    in property <bool> ytdlp-updating;
    in property <string> ytdlp-note;

    // listening party: 0 = none, 1 = hosting, 2 = following a host
    in property <int> party-mode;
    in property <bool> party-connecting;
    in property <string> party-room;
    in property <string> party-host-name;
    in property <[PartyMember]> party-members;
    in property <string> party-note;
    in property <string> party-sync;
    /// The host lets everyone play, pause, skip, seek and add songs
    in property <bool> party-control;
    callback party-control-changed(bool);
    // updates
    in property <string> app-version;
    in property <bool> update-available;
    in property <string> update-version;
    in property <string> update-notes;
    /// Where the download link leads, shown next to the button
    in property <string> update-host;
    in property <bool> update-checking;
    in property <string> update-note;
    in-out property <bool> auto-update-check: true;
    property <bool> update-dismissed;
    callback check-update();
    callback open-update();
    callback set-auto-update(bool);

    in-out property <string> party-server;
    /// Parties have a server to use (typed in Settings, or built into the app)
    in property <bool> party-server-ready;
    /// The app ships with a server address, so Settings can leave the field empty
    in property <bool> party-server-built-in;
    in-out property <string> display-name;
    in-out property <string> party-code-input;
    /// Guests follow the host, so playback controls are switched off for them
    in property <bool> controls-locked;

    callback copy-text(string);
    callback party-start();
    callback party-join(string);
    callback party-leave();
    callback party-server-edited(string);
    callback display-name-edited(string);
    callback prefetch-result(int);
    callback prefetch-playlist-track(int);
    callback prefetch-queue(int);
    callback open-library();
    callback refresh-library();
    callback open-playlist(int);
    callback play-playlist-track(int);
    callback add-playlist-track(int);
    callback play-all();
    callback add-all();
    callback sign-in(string);
    callback sign-in-google();
    callback sign-out();
    callback search(string);
    callback play-result(int);
    callback add-result(int);
    callback play-queue(int);
    callback remove-queue(int);
    callback clear-queue();
    callback toggle-pause();
    callback next();
    callback prev();
    callback seek(float);
    callback set-volume(float);
    callback toggle-shuffle();
    callback cycle-repeat();
    /// Which view is showing: 0 search, 1 library, 2 lyrics, -1 settings
    callback view-changed(int);
    callback set-perf(bool);
    callback clear-cache();
    callback update-ytdlp();
    callback seek-lyric(float);

    pure function clock(secs: float) -> string {
        return "\{Math.floor(secs / 60)}:\{Math.mod(Math.floor(secs), 60) < 10 ? "0" : ""}\{Math.mod(Math.floor(secs), 60)}";
    }

    fs := FocusScope {
        init => {
            self.focus();
        }
        key-pressed(e) => {
            // typing in the search box is handled by the box itself, so these only fire elsewhere
            if (e.text == " ") {
                root.toggle-pause();
                return accept;
            }
            if (e.text == Key.LeftArrow) {
                if (e.modifiers.control) {
                    root.prev();
                } else {
                    root.seek-by(-5.0);
                }
                return accept;
            }
            if (e.text == Key.RightArrow) {
                if (e.modifiers.control) {
                    root.next();
                } else {
                    root.seek-by(5.0);
                }
                return accept;
            }
            if (e.text == Key.UpArrow || e.text == Key.DownArrow) {
                root.volume = Math.max(0.0, Math.min(1.0, root.volume + (e.text == Key.UpArrow ? 0.05 : -0.05)));
                root.set-volume(root.volume);
                return accept;
            }
            if (e.text == "/" || (e.modifiers.control && e.text == "f")) {
                root.settings-open = false;
                root.artist-open = false;
                root.close-artist();
                root.tab = 0;
                root.view-changed(0);
                root.want-search-focus = true;
                return accept;
            }
            if (e.text == Key.Escape) {
                if (root.artist-open) {
                    root.artist-back();
                } else if (root.settings-open) {
                    root.settings-open = false;
                    root.view-changed(root.tab);
                }
                fs.focus();
                return accept;
            }
            return reject;
        }
    VerticalLayout {
        HorizontalLayout {
            VerticalLayout {
                padding: 14px;
                spacing: 10px;
                horizontal-stretch: 1;
                HorizontalLayout {
                    spacing: 18px;
                    height: 28px;
                    TabButton {
                        label: "Search";
                        active: root.tab == 0 && !root.settings-open && !root.artist-open;
                        clicked => {
                            root.tab = 0;
                            root.settings-open = false;
                            root.artist-open = false;
                            root.close-artist();
                            root.view-changed(0);
                        }
                    }
                    TabButton {
                        label: "Library";
                        active: root.tab == 1 && !root.settings-open && !root.artist-open;
                        clicked => {
                            root.tab = 1;
                            root.settings-open = false;
                            root.artist-open = false;
                            root.close-artist();
                            root.view-changed(1);
                            root.open-library();
                        }
                    }
                    TabButton {
                        label: "Lyrics";
                        active: root.tab == 2 && !root.settings-open && !root.artist-open;
                        clicked => {
                            root.tab = 2;
                            root.settings-open = false;
                            root.artist-open = false;
                            root.close-artist();
                            root.view-changed(2);
                        }
                    }
                    TabButton {
                        label: "Party";
                        active: root.tab == 3 && !root.settings-open && !root.artist-open;
                        clicked => {
                            root.tab = 3;
                            root.settings-open = false;
                            root.artist-open = false;
                            root.close-artist();
                            root.view-changed(3);
                        }
                    }
                    Rectangle {
                        horizontal-stretch: 1;
                    }
                    VerticalLayout {
                        alignment: center;
                        IconButton {
                            glyph: Glyphs.settings;
                            size: 28px;
                            tip: "Settings";
                            tip-below: true;
                            on: root.settings-open;
                            clicked => {
                                root.settings-open = !root.settings-open;
                                root.view-changed(root.settings-open ? -1 : root.tab);
                            }
                        }
                    }
                }
                if root.update-available && !root.update-dismissed: Rectangle {
                    height: 40px;
                    border-radius: 8px;
                    background: Theme.accent-bg;
                    HorizontalLayout {
                        padding-left: 12px;
                        padding-right: 8px;
                        spacing: 10px;
                        VerticalLayout {
                            alignment: center;
                            horizontal-stretch: 1;
                            Text {
                                text: "Version " + root.update-version + " is available" + (root.update-notes != "" ? " · " + root.update-notes : "");
                                font-size: 12px;
                                color: Theme.text;
                                overflow: elide;
                            }
                        }
                        VerticalLayout {
                            alignment: center;
                            TextButton {
                                label: "Get update";
                                clicked => {
                                    root.open-update();
                                }
                            }
                        }
                        VerticalLayout {
                            alignment: center;
                            IconButton {
                                glyph: Glyphs.close;
                                size: 24px;
                                tip: "Dismiss";
                                tip-below: true;
                                clicked => {
                                    root.update-dismissed = true;
                                }
                            }
                        }
                    }
                }
                if root.settings-open: VerticalLayout {
                    vertical-stretch: 1;
                    alignment: start;
                    spacing: 2px;
                    Rectangle {
                        height: 64px;
                        border-radius: 8px;
                        background: ab-ta.has-hover ? Theme.hover : transparent;
                        ab-ta := TouchArea { }
                        HorizontalLayout {
                            padding-left: 10px;
                            padding-right: 10px;
                            spacing: 12px;
                            VerticalLayout {
                                alignment: center;
                                horizontal-stretch: 1;
                                Text {
                                    text: "Version " + root.app-version;
                                    font-size: 13px;
                                    font-weight: 500;
                                    color: Theme.text;
                                }
                                Text {
                                    text: root.update-checking ? "Checking…" : (root.update-available ? "Version " + root.update-version + " is available at " + root.update-host : (root.update-note != "" ? root.update-note : "Checks once a day"));
                                    font-size: 12px;
                                    color: Theme.text2;
                                    wrap: word-wrap;
                                }
                            }
                            VerticalLayout {
                                alignment: center;
                                TextButton {
                                    label: root.update-available ? "Get update" : "Check now";
                                    clicked => {
                                        if root.update-available {
                                            root.open-update();
                                        } else {
                                            root.check-update();
                                        }
                                    }
                                }
                            }
                            VerticalLayout {
                                alignment: center;
                                Toggle {
                                    checked: root.auto-update-check;
                                    toggled(on) => {
                                        root.auto-update-check = on;
                                        root.set-auto-update(on);
                                    }
                                }
                            }
                        }
                    }
                    Rectangle {
                        height: 64px;
                        border-radius: 8px;
                        background: pr-ta.has-hover ? Theme.hover : transparent;
                        pr-ta := TouchArea { }
                        HorizontalLayout {
                            padding-left: 10px;
                            padding-right: 10px;
                            spacing: 12px;
                            VerticalLayout {
                                alignment: center;
                                horizontal-stretch: 1;
                                Text {
                                    text: "Performance saving";
                                    font-size: 13px;
                                    font-weight: 500;
                                    color: Theme.text;
                                }
                                Text {
                                    text: "Turns off animations and covers, and refreshes the progress bar less often";
                                    font-size: 12px;
                                    color: Theme.text2;
                                    wrap: word-wrap;
                                }
                            }
                            VerticalLayout {
                                alignment: center;
                                Toggle {
                                    checked: root.perf-mode;
                                    toggled(on) => {
                                        root.perf-mode = on;
                                        root.set-perf(on);
                                    }
                                }
                            }
                        }
                    }
                    Rectangle {
                        height: 64px;
                        border-radius: 8px;
                        background: ca-ta.has-hover ? Theme.hover : transparent;
                        ca-ta := TouchArea { }
                        HorizontalLayout {
                            padding-left: 10px;
                            padding-right: 10px;
                            spacing: 12px;
                            VerticalLayout {
                                alignment: center;
                                horizontal-stretch: 1;
                                Text {
                                    text: "Audio cache";
                                    font-size: 13px;
                                    font-weight: 500;
                                    color: Theme.text;
                                }
                                Text {
                                    text: root.cache-text;
                                    font-size: 12px;
                                    color: Theme.text2;
                                }
                            }
                            VerticalLayout {
                                alignment: center;
                                TextButton {
                                    label: "Clear";
                                    clicked => {
                                        root.clear-cache();
                                    }
                                }
                            }
                        }
                    }
                    Rectangle {
                        height: 64px;
                        border-radius: 8px;
                        background: yt-ta.has-hover ? Theme.hover : transparent;
                        yt-ta := TouchArea { }
                        HorizontalLayout {
                            padding-left: 10px;
                            padding-right: 10px;
                            spacing: 12px;
                            VerticalLayout {
                                alignment: center;
                                horizontal-stretch: 1;
                                Text {
                                    text: "yt-dlp";
                                    font-size: 13px;
                                    font-weight: 500;
                                    color: Theme.text;
                                }
                                Text {
                                    text: root.ytdlp-note != "" ? root.ytdlp-note : (root.ytdlp-version != "" ? "Version " + root.ytdlp-version : "Checking version…");
                                    font-size: 12px;
                                    color: Theme.text2;
                                    wrap: word-wrap;
                                }
                            }
                            VerticalLayout {
                                alignment: center;
                                TextButton {
                                    label: root.ytdlp-updating ? "Updating…" : "Update";
                                    clicked => {
                                        root.update-ytdlp();
                                    }
                                }
                            }
                        }
                    }
                    Rectangle {
                        height: 64px;
                        border-radius: 8px;
                        background: ac-ta.has-hover ? Theme.hover : transparent;
                        ac-ta := TouchArea { }
                        HorizontalLayout {
                            padding-left: 10px;
                            padding-right: 10px;
                            spacing: 12px;
                            VerticalLayout {
                                alignment: center;
                                horizontal-stretch: 1;
                                Text {
                                    text: "Account";
                                    font-size: 13px;
                                    font-weight: 500;
                                    color: Theme.text;
                                }
                                Text {
                                    text: root.signed-in ? "Signed in with Google" : "Not signed in";
                                    font-size: 12px;
                                    color: Theme.text2;
                                }
                            }
                            if root.signed-in: VerticalLayout {
                                alignment: center;
                                TextButton {
                                    label: "Sign out";
                                    clicked => {
                                        root.sign-out();
                                    }
                                }
                            }
                        }
                    }
                    Rectangle {
                        height: 64px;
                        border-radius: 8px;
                        background: nm-ta.has-hover ? Theme.hover : transparent;
                        nm-ta := TouchArea { }
                        HorizontalLayout {
                            padding-left: 10px;
                            padding-right: 10px;
                            spacing: 12px;
                            VerticalLayout {
                                alignment: center;
                                horizontal-stretch: 1;
                                Text {
                                    text: "Display name";
                                    font-size: 13px;
                                    font-weight: 500;
                                    color: Theme.text;
                                }
                                Text {
                                    text: "Shown to everyone in a party";
                                    font-size: 12px;
                                    color: Theme.text2;
                                }
                            }
                            VerticalLayout {
                                alignment: center;
                                TextField {
                                    min-width: 220px;
                                    max-width: 220px;
                                    text <=> root.display-name;
                                    placeholder: "Your name";
                                    edited(t) => {
                                        root.display-name-edited(t);
                                    }
                                }
                            }
                        }
                    }
                    Rectangle {
                        height: 64px;
                        border-radius: 8px;
                        background: sv-ta.has-hover ? Theme.hover : transparent;
                        sv-ta := TouchArea { }
                        HorizontalLayout {
                            padding-left: 10px;
                            padding-right: 10px;
                            spacing: 12px;
                            VerticalLayout {
                                alignment: center;
                                horizontal-stretch: 1;
                                Text {
                                    text: "Party server";
                                    font-size: 13px;
                                    font-weight: 500;
                                    color: Theme.text;
                                }
                                Text {
                                    text: root.party-server-built-in ? "Advanced. Leave empty to use the built-in server" : "The relay everyone in a party connects through";
                                    font-size: 12px;
                                    color: Theme.text2;
                                }
                            }
                            VerticalLayout {
                                alignment: center;
                                TextField {
                                    min-width: 220px;
                                    max-width: 220px;
                                    text <=> root.party-server;
                                    placeholder: root.party-server-built-in ? "Built-in server" : "wss://your-relay.example.com";
                                    edited(t) => {
                                        root.party-server-edited(t);
                                    }
                                }
                            }
                        }
                    }
                }
                if root.artist-open && !root.settings-open: VerticalLayout {
                    spacing: 10px;
                    vertical-stretch: 1;
                    HorizontalLayout {
                        height: 30px;
                        TextButton {
                            label: "Back";
                            clicked => {
                                root.artist-back();
                            }
                        }
                        Rectangle {
                            horizontal-stretch: 1;
                        }
                    }
                    HorizontalLayout {
                        height: 72px;
                        spacing: 14px;
                        VerticalLayout {
                            alignment: center;
                            Rectangle {
                                min-width: 72px;
                                max-width: 72px;
                                min-height: 72px;
                                max-height: 72px;
                                border-radius: 8px;
                                background: Theme.border;
                                clip: true;
                                if root.artist-image.width > 0 && !Theme.perf: Image {
                                    source: root.artist-image;
                                    width: parent.width;
                                    height: parent.height;
                                }
                                if root.artist-image.width == 0 || Theme.perf: Icon {
                                    glyph: Glyphs.music;
                                    tint: Theme.text3;
                                    width: 26px;
                                    height: 26px;
                                    x: (parent.width - self.width) / 2;
                                    y: (parent.height - self.height) / 2;
                                }
                            }
                        }
                        VerticalLayout {
                            alignment: center;
                            horizontal-stretch: 1;
                            spacing: 2px;
                            Text {
                                text: root.artist-name;
                                font-size: 20px;
                                font-weight: 500;
                                color: Theme.text;
                                overflow: elide;
                            }
                            Text {
                                text: root.artist-sub;
                                font-size: 12px;
                                color: Theme.text2;
                                overflow: elide;
                            }
                            HorizontalLayout {
                                padding-top: 6px;
                                spacing: 8px;
                                TextButton {
                                    label: "Play all";
                                    primary: true;
                                    clicked => {
                                        root.play-all();
                                    }
                                }
                                TextButton {
                                    label: "Add all";
                                    clicked => {
                                        root.add-all();
                                    }
                                }
                                Rectangle {
                                    horizontal-stretch: 1;
                                }
                            }
                        }
                    }
                    Rectangle {
                        vertical-stretch: 1;
                        ScrollList {
                            VerticalLayout {
                                spacing: 2px;
                                alignment: start;
                                if root.playlist-tracks.length > 0: Text {
                                    text: root.artist-album ? "Tracks" : "Top songs";
                                    font-size: 12px;
                                    font-weight: 500;
                                    color: Theme.text2;
                                    height: 26px;
                                    vertical-alignment: center;
                                }
                                for item[i] in root.playlist-tracks: TrackRow {
                                    menu: true;
                                    menu-add: true;
                                    menu-play-next => {
                                        root.play-next-playlist-track(i);
                                    }
                                    menu-add-clicked => {
                                        root.add-playlist-track(i);
                                    }
                                    menu-copy-link(url) => {
                                        root.copy-text(url);
                                    }
                                    menu-open-web(id) => {
                                        root.open-track-web(id);
                                    }
                                    item: item;
                                    action-glyph: Glyphs.plus;
                                    action-tip: "Add to queue";
                                    hover-intent => {
                                        root.prefetch-playlist-track(i);
                                    }
                                    activated => {
                                        root.play-playlist-track(i);
                                    }
                                    action => {
                                        root.add-playlist-track(i);
                                    }
                                    artist-clicked(id) => {
                                        root.open-artist(id);
                                    }
                                }
                                if root.artist-albums.length > 0 && !root.artist-album: Text {
                                    text: "Albums and singles";
                                    font-size: 12px;
                                    font-weight: 500;
                                    color: Theme.text2;
                                    height: 40px;
                                    vertical-alignment: bottom;
                                }
                                if !root.artist-album: VerticalLayout {
                                    spacing: 2px;
                                    for item[i] in root.artist-albums: TrackRow {
                                        item: item;
                                        playable: false;
                                        activated => {
                                            root.open-album(i);
                                        }
                                    }
                                }
                            }
                        }
                        if root.artist-loading || root.artist-note != "": Text {
                            text: root.artist-loading ? "Loading…" : root.artist-note;
                            color: Theme.text3;
                            font-size: 14px;
                            wrap: word-wrap;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }
                }
                if !root.settings-open && !root.artist-open && root.tab == 0: VerticalLayout {
                    spacing: 10px;
                    vertical-stretch: 1;
                    Rectangle {
                        height: 38px;
                        border-radius: 8px;
                        border-width: 1px;
                        border-color: input.has-focus ? Theme.accent : Theme.border;
                        background: Theme.surface;
                        Icon {
                            glyph: Glyphs.search;
                            tint: Theme.text3;
                            x: 10px;
                            y: (parent.height - self.height) / 2;
                            width: 18px;
                            height: 18px;
                        }
                        if root.query == "": Text {
                            text: "Search songs, artists, albums";
                            color: Theme.text3;
                            font-size: 14px;
                            x: 36px;
                            y: (parent.height - self.height) / 2;
                        }
                        input := TextInput {
                            text <=> root.query;
                            x: 36px;
                            y: 0px;
                            height: parent.height;
                            vertical-alignment: center;
                            width: parent.width - 48px;
                            font-size: 14px;
                            color: Theme.text;
                            accepted => {
                                root.search(root.query);
                                // hand the keyboard back, so Space and the arrows work on the results
                                fs.focus();
                            }
                        }
                        Timer {
                            interval: 60ms;
                            running: root.want-search-focus;
                            triggered => {
                                root.want-search-focus = false;
                                input.focus();
                                // so the next thing typed replaces the old search
                                input.select-all();
                            }
                        }
                    }
                    Rectangle {
                        vertical-stretch: 1;
                        ScrollList {
                            VerticalLayout {
                                spacing: 2px;
                                alignment: start;
                                for item[i] in root.results: TrackRow {
                                    menu: true;
                                    menu-add: true;
                                    menu-play-next => {
                                        root.play-next-result(i);
                                    }
                                    menu-add-clicked => {
                                        root.add-result(i);
                                    }
                                    menu-copy-link(url) => {
                                        root.copy-text(url);
                                    }
                                    menu-open-web(id) => {
                                        root.open-track-web(id);
                                    }
                                    artist-clicked(id) => {
                                        root.open-artist(id);
                                    }
                                    item: item;
                                    action-glyph: Glyphs.plus;
                                    action-tip: "Add to queue";
                                    hover-intent => {
                                        root.prefetch-result(i);
                                    }
                                    activated => {
                                        root.play-result(i);
                                    }
                                    action => {
                                        root.add-result(i);
                                    }
                                }
                            }
                        }
                        if root.results.length == 0: Text {
                            text: root.searching ? "Searching…" : (root.search-note != "" ? root.search-note : "Search for something to play");
                            color: Theme.text3;
                            font-size: 14px;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }
                }
                if !root.settings-open && !root.artist-open && root.tab == 1 && !root.signed-in: VerticalLayout {
                    vertical-stretch: 1;
                    alignment: center;
                    spacing: 12px;
                    Text {
                        text: "Sign in to see your library";
                        color: Theme.text;
                        font-size: 16px;
                        font-weight: 500;
                        horizontal-alignment: center;
                    }
                    Text {
                        text: "A Google sign-in window opens inside the app. Your password goes to Google's own page and is never seen by this app.";
                        color: Theme.text2;
                        font-size: 12px;
                        wrap: word-wrap;
                        horizontal-alignment: center;
                    }
                    HorizontalLayout {
                        alignment: center;
                        TextButton {
                            label: root.signing-in ? "Signing in…" : "Sign in with Google";
                            primary: true;
                            clicked => {
                                root.sign-in-google();
                            }
                        }
                    }
                    Text {
                        text: root.auth-note;
                        color: Theme.danger;
                        font-size: 12px;
                        wrap: word-wrap;
                        horizontal-alignment: center;
                    }
                    Text {
                        text: "Or import a cookies.txt file, or type a browser name (firefox, brave, chrome, edge)";
                        color: Theme.text3;
                        font-size: 12px;
                        wrap: word-wrap;
                        horizontal-alignment: center;
                    }
                    HorizontalLayout {
                        spacing: 8px;
                        Rectangle {
                            height: 34px;
                            horizontal-stretch: 1;
                            border-radius: 8px;
                            border-width: 1px;
                            border-color: signin-field.has-focus ? Theme.accent : Theme.border;
                            background: Theme.surface;
                            if root.signin-input == "": Text {
                                text: "C:\\path\\to\\cookies.txt  or  firefox";
                                color: Theme.text3;
                                font-size: 13px;
                                x: 12px;
                                y: (parent.height - self.height) / 2;
                            }
                            signin-field := TextInput {
                                text <=> root.signin-input;
                                x: 12px;
                                y: 0px;
                                height: parent.height;
                                vertical-alignment: center;
                                width: parent.width - 24px;
                                font-size: 13px;
                                color: Theme.text;
                                accepted => {
                                    root.sign-in(root.signin-input);
                                }
                            }
                        }
                        VerticalLayout {
                            alignment: center;
                            TextButton {
                                label: "Import";
                                clicked => {
                                    root.sign-in(root.signin-input);
                                }
                            }
                        }
                    }
                }
                if !root.settings-open && !root.artist-open && root.tab == 1 && root.signed-in && !root.in-playlist: VerticalLayout {
                    spacing: 10px;
                    vertical-stretch: 1;
                    HorizontalLayout {
                        height: 26px;
                        spacing: 8px;
                        Text {
                            text: "Your playlists";
                            color: Theme.text2;
                            font-size: 12px;
                            font-weight: 500;
                            vertical-alignment: center;
                            horizontal-stretch: 1;
                        }
                        IconButton {
                            glyph: Glyphs.refresh;
                            size: 26px;
                            tip: "Refresh";
                            tip-below: true;
                            clicked => {
                                root.refresh-library();
                            }
                        }
                        TextLink {
                            label: "Sign out";
                            clicked => {
                                root.sign-out();
                            }
                        }
                    }
                    Rectangle {
                        vertical-stretch: 1;
                        ScrollList {
                            VerticalLayout {
                                spacing: 2px;
                                alignment: start;
                                for item[i] in root.playlists: TrackRow {
                                    item: item;
                                    playable: false;
                                    activated => {
                                        root.in-playlist = true;
                                        root.open-playlist(i);
                                    }
                                }
                            }
                        }
                        if root.playlists.length == 0: Text {
                            text: root.library-loading ? "Loading your library…" : (root.library-note != "" ? root.library-note : "No playlists found");
                            color: Theme.text3;
                            font-size: 14px;
                            wrap: word-wrap;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }
                }
                if !root.settings-open && !root.artist-open && root.tab == 1 && root.signed-in && root.in-playlist: VerticalLayout {
                    spacing: 10px;
                    vertical-stretch: 1;
                    HorizontalLayout {
                        height: 30px;
                        spacing: 10px;
                        TextButton {
                            label: "Back";
                            clicked => {
                                root.in-playlist = false;
                            }
                        }
                        Text {
                            text: root.playlist-title;
                            color: Theme.text;
                            font-size: 14px;
                            font-weight: 500;
                            vertical-alignment: center;
                            overflow: elide;
                            horizontal-stretch: 1;
                        }
                        TextButton {
                            label: "Play all";
                            primary: true;
                            clicked => {
                                root.play-all();
                            }
                        }
                        TextButton {
                            label: "Add all";
                            clicked => {
                                root.add-all();
                            }
                        }
                    }
                    Rectangle {
                        vertical-stretch: 1;
                        ScrollList {
                            VerticalLayout {
                                spacing: 2px;
                                alignment: start;
                                for item[i] in root.playlist-tracks: TrackRow {
                                    menu: true;
                                    menu-add: true;
                                    menu-play-next => {
                                        root.play-next-playlist-track(i);
                                    }
                                    menu-add-clicked => {
                                        root.add-playlist-track(i);
                                    }
                                    menu-copy-link(url) => {
                                        root.copy-text(url);
                                    }
                                    menu-open-web(id) => {
                                        root.open-track-web(id);
                                    }
                                    artist-clicked(id) => {
                                        root.open-artist(id);
                                    }
                                    item: item;
                                    action-glyph: Glyphs.plus;
                                    action-tip: "Add to queue";
                                    hover-intent => {
                                        root.prefetch-playlist-track(i);
                                    }
                                    activated => {
                                        root.play-playlist-track(i);
                                    }
                                    action => {
                                        root.add-playlist-track(i);
                                    }
                                }
                            }
                        }
                        if root.playlist-tracks.length == 0: Text {
                            text: root.playlist-loading ? "Loading…" : (root.playlist-note != "" ? root.playlist-note : "This playlist is empty");
                            color: Theme.text3;
                            font-size: 14px;
                            wrap: word-wrap;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }
                }
                if !root.settings-open && !root.artist-open && root.tab == 2: VerticalLayout {
                    spacing: 8px;
                    vertical-stretch: 1;
                    HorizontalLayout {
                        height: 20px;
                        Text {
                            text: root.now-title;
                            color: Theme.text2;
                            font-size: 12px;
                            font-weight: 500;
                            vertical-alignment: center;
                            overflow: elide;
                            horizontal-stretch: 1;
                        }
                        Text {
                            text: root.lyrics-source;
                            color: Theme.text3;
                            font-size: 11px;
                            vertical-alignment: center;
                            horizontal-alignment: right;
                        }
                    }
                    Rectangle {
                        vertical-stretch: 1;
                        property <int> now: root.lyrics-current;
                        property <int> count: root.lyrics-lines.length;
                        changed now => {
                            lyric-list.scroll-center(root.lyrics-current * 36px + 18px);
                        }
                        changed count => {
                            lyric-list.scroll-center(0px);
                        }
                        lyric-list := ScrollList {
                            VerticalLayout {
                                alignment: start;
                                for line[i] in root.lyrics-lines: LyricRow {
                                    line: line;
                                    current: root.lyrics-synced && i == root.lyrics-current;
                                    seekable: root.lyrics-synced;
                                    activated => {
                                        root.seek-lyric(line.time);
                                    }
                                }
                            }
                        }
                        if root.lyrics-lines.length == 0: Text {
                            text: root.lyrics-loading ? "Looking for lyrics…" : (root.lyrics-note != "" ? root.lyrics-note : "Play a song to see its lyrics");
                            color: Theme.text3;
                            font-size: 14px;
                            wrap: word-wrap;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }
                }
                if !root.settings-open && !root.artist-open && root.tab == 3: VerticalLayout {
                    spacing: 12px;
                    vertical-stretch: 1;
                    alignment: start;
                    if root.party-note != "": Text {
                        text: root.party-note;
                        color: Theme.danger;
                        font-size: 12px;
                        wrap: word-wrap;
                    }
                    if root.party-mode == 0 && !root.party-server-ready: Rectangle {
                        height: 72px;
                        border-radius: 12px;
                        background: Theme.accent-bg;
                        HorizontalLayout {
                            padding: 14px;
                            spacing: 12px;
                            VerticalLayout {
                                alignment: center;
                                horizontal-stretch: 1;
                                Text {
                                    text: "Add a party server first";
                                    font-size: 13px;
                                    font-weight: 500;
                                    color: Theme.text;
                                }
                                Text {
                                    text: "Parties connect through a small relay server. Paste its address in Settings.";
                                    font-size: 12px;
                                    color: Theme.text2;
                                    wrap: word-wrap;
                                }
                            }
                            VerticalLayout {
                                alignment: center;
                                TextButton {
                                    label: "Open settings";
                                    clicked => {
                                        root.settings-open = true;
                                        root.view-changed(-1);
                                    }
                                }
                            }
                        }
                    }
                    if root.party-mode == 0: Card {
                        height: 116px;
                        Text {
                            text: "Start a party";
                            font-size: 14px;
                            font-weight: 500;
                            color: Theme.text;
                        }
                        Text {
                            text: "You choose what plays. Friends who join hear it at the same moment.";
                            font-size: 12px;
                            color: Theme.text2;
                            wrap: word-wrap;
                        }
                        HorizontalLayout {
                            padding-top: 6px;
                            TextButton {
                                label: "Start a party";
                                primary: true;
                                clicked => {
                                    root.party-start();
                                }
                            }
                            Rectangle {
                                horizontal-stretch: 1;
                            }
                        }
                    }
                    if root.party-mode == 0: Card {
                        height: 128px;
                        Text {
                            text: "Join a party";
                            font-size: 14px;
                            font-weight: 500;
                            color: Theme.text;
                        }
                        Text {
                            text: "Enter the code the host shares with you.";
                            font-size: 12px;
                            color: Theme.text2;
                        }
                        HorizontalLayout {
                            padding-top: 6px;
                            spacing: 8px;
                            TextField {
                                horizontal-stretch: 1;
                                text <=> root.party-code-input;
                                placeholder: "Party code";
                                accepted(t) => {
                                    root.party-join(t);
                                }
                            }
                            VerticalLayout {
                                alignment: center;
                                TextButton {
                                    label: "Join";
                                    clicked => {
                                        root.party-join(root.party-code-input);
                                    }
                                }
                            }
                        }
                    }
                    if root.party-mode > 0 && root.party-connecting: Text {
                        text: "Connecting to the party server…";
                        color: Theme.text3;
                        font-size: 13px;
                    }
                    if root.party-mode == 2 && !root.party-connecting: Rectangle {
                        height: 36px;
                        border-radius: 8px;
                        background: Theme.accent-bg;
                        Text {
                            text: root.party-control ? "Listening with " + root.party-host-name + ". Everyone can control playback." : "Listening with " + root.party-host-name + ". Only the host controls playback.";
                            color: Theme.accent;
                            font-size: 12px;
                            x: 12px;
                            width: parent.width - 24px;
                            vertical-alignment: center;
                            overflow: elide;
                        }
                    }
                    if root.party-mode > 0 && !root.party-connecting: Card {
                        height: root.party-mode == 1 ? 140px : 96px;
                        property <bool> copied;
                        Timer {
                            interval: 1500ms;
                            running: copied;
                            triggered => {
                                copied = false;
                            }
                        }
                        if root.party-mode == 1: Text {
                            text: "Your party code";
                            font-size: 12px;
                            color: Theme.text2;
                        }
                        if root.party-mode == 1: Text {
                            text: root.party-room;
                            font-size: 30px;
                            font-weight: 500;
                            font-family: "Consolas";
                            letter-spacing: 4px;
                            color: Theme.text;
                        }
                        if root.party-mode == 2: Text {
                            text: root.party-host-name + "'s party";
                            font-size: 14px;
                            font-weight: 500;
                            color: Theme.text;
                        }
                        if root.party-mode == 2: Text {
                            text: "Code \{root.party-room} · \{root.party-members.length} listening\{root.party-sync != "" ? " · " + root.party-sync : ""}";
                            font-size: 12px;
                            color: Theme.text2;
                        }
                        HorizontalLayout {
                            padding-top: 4px;
                            spacing: 8px;
                            if root.party-mode == 1: TextButton {
                                label: copied ? "Copied" : "Copy code";
                                clicked => {
                                    root.copy-text(root.party-room);
                                    copied = true;
                                }
                            }
                            TextButton {
                                label: root.party-mode == 1 ? "End party" : "Leave party";
                                danger: true;
                                clicked => {
                                    root.party-leave();
                                }
                            }
                            Rectangle {
                                horizontal-stretch: 1;
                            }
                        }
                    }
                    if root.party-mode == 1 && !root.party-connecting: Rectangle {
                        height: 52px;
                        border-radius: 8px;
                        background: pc-ta.has-hover ? Theme.hover : transparent;
                        pc-ta := TouchArea { }
                        HorizontalLayout {
                            padding-left: 10px;
                            padding-right: 10px;
                            spacing: 12px;
                            VerticalLayout {
                                alignment: center;
                                horizontal-stretch: 1;
                                Text {
                                    text: "Everyone can control";
                                    font-size: 13px;
                                    font-weight: 500;
                                    color: Theme.text;
                                }
                                Text {
                                    text: "Guests can play, pause, skip, seek and add songs";
                                    font-size: 12px;
                                    color: Theme.text2;
                                    overflow: elide;
                                }
                            }
                            VerticalLayout {
                                alignment: center;
                                Toggle {
                                    checked: root.party-control;
                                    toggled(on) => {
                                        root.party-control-changed(on);
                                    }
                                }
                            }
                        }
                    }
                    if root.party-mode > 0 && !root.party-connecting: VerticalLayout {
                        spacing: 2px;
                        Text {
                            text: "Listening now · \{root.party-members.length}";
                            font-size: 12px;
                            color: Theme.text2;
                        }
                        for m in root.party-members: Rectangle {
                            height: 40px;
                            border-radius: 8px;
                            background: m-ta.has-hover ? Theme.hover : transparent;
                            m-ta := TouchArea { }
                            HorizontalLayout {
                                padding-left: 8px;
                                padding-right: 8px;
                                spacing: 10px;
                                VerticalLayout {
                                    alignment: center;
                                    Rectangle {
                                        min-width: 28px;
                                        max-width: 28px;
                                        min-height: 28px;
                                        max-height: 28px;
                                        border-radius: 14px;
                                        background: Theme.accent-bg;
                                        Text {
                                            text: m.initial;
                                            color: Theme.accent;
                                            font-size: 12px;
                                            font-weight: 500;
                                            horizontal-alignment: center;
                                            vertical-alignment: center;
                                        }
                                    }
                                }
                                Text {
                                    text: m.name;
                                    font-size: 13px;
                                    color: Theme.text;
                                    vertical-alignment: center;
                                    horizontal-stretch: 1;
                                    overflow: elide;
                                }
                                if m.tag != "": VerticalLayout {
                                    alignment: center;
                                    Rectangle {
                                        min-width: pill-text.preferred-width + 16px;
                                        max-width: pill-text.preferred-width + 16px;
                                        height: 20px;
                                        border-radius: 10px;
                                        background: m.tag == "In sync" ? Theme.success-bg : (m.tag == "Host" ? Theme.accent-bg : Theme.surface);
                                        pill-text := Text {
                                            text: m.tag;
                                            font-size: 11px;
                                            color: m.tag == "In sync" ? Theme.success : (m.tag == "Host" ? Theme.accent : Theme.text2);
                                            horizontal-alignment: center;
                                            vertical-alignment: center;
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
            Rectangle {
                width: 1px;
                background: Theme.border;
            }
            VerticalLayout {
                padding: 14px;
                spacing: 10px;
                min-width: 270px;
                max-width: 270px;
                HorizontalLayout {
                    height: 22px;
                    Text {
                        text: "Up next";
                        color: Theme.text2;
                        font-size: 12px;
                        font-weight: 500;
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                    }
                    if root.queue.length > 0: TextLink {
                        label: "Clear";
                        clicked => {
                            root.clear-queue();
                        }
                    }
                }
                Rectangle {
                    vertical-stretch: 1;
                    ScrollList {
                        VerticalLayout {
                            spacing: 2px;
                            alignment: start;
                            for item[i] in root.queue: TrackRow {
                                menu: true;
                                menu-remove: true;
                                menu-play-next => {
                                    root.play-next-queue(i);
                                }
                                menu-remove-clicked => {
                                    root.remove-queue(i);
                                }
                                menu-copy-link(url) => {
                                    root.copy-text(url);
                                }
                                menu-open-web(id) => {
                                    root.open-track-web(id);
                                }
                                artist-clicked(id) => {
                                    root.open-artist(id);
                                }
                                item: item;
                                current: i == root.current-index;
                                draggable: !root.controls-locked;
                                line-top: root.drag-to == i && root.drag-to < root.drag-from;
                                line-bottom: root.drag-to == i && root.drag-to > root.drag-from;
                                drag-update(dy) => {
                                    root.drag-from = i;
                                    // rows are 48px tall with 2px between them
                                    root.drag-to = Math.max(0, Math.min(root.queue.length - 1, i + Math.round(dy / 50px)));
                                }
                                drag-finish => {
                                    if (root.drag-from >= 0 && root.drag-to != root.drag-from) {
                                        root.move-queue(root.drag-from, root.drag-to);
                                    }
                                    root.drag-from = -1;
                                    root.drag-to = -1;
                                }
                                action-glyph: Glyphs.close;
                                action-tip: "Remove";
                                hover-intent => {
                                    root.prefetch-queue(i);
                                }
                                activated => {
                                    root.play-queue(i);
                                }
                                action => {
                                    root.remove-queue(i);
                                }
                            }
                        }
                    }
                    if root.queue.length == 0: Text {
                        text: "Your queue is empty.\nAdd tracks with +";
                        color: Theme.text3;
                        font-size: 13px;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
            }
        }
        Rectangle {
            height: 1px;
            background: Theme.border;
        }
        Rectangle {
            height: 76px;
            background: Theme.surface;
            HorizontalLayout {
                padding-left: 14px;
                padding-right: 16px;
                spacing: 12px;
                VerticalLayout {
                    alignment: center;
                    Rectangle {
                        min-width: 48px;
                        max-width: 48px;
                        min-height: 48px;
                        max-height: 48px;
                        border-radius: 6px;
                        background: Theme.accent-bg;
                        clip: true;
                        if root.now-cover.width > 0 && !Theme.perf: Image {
                            source: root.now-cover;
                            width: parent.width;
                            height: parent.height;
                        }
                        if root.now-cover.width == 0 || Theme.perf: Icon {
                            glyph: Glyphs.music;
                            tint: Theme.accent;
                            width: 22px;
                            height: 22px;
                            x: (parent.width - self.width) / 2;
                            y: (parent.height - self.height) / 2;
                        }
                    }
                }
                VerticalLayout {
                    alignment: center;
                    min-width: 150px;
                    max-width: 150px;
                    Text {
                        text: root.now-title;
                        color: Theme.text;
                        font-size: 13px;
                        font-weight: 500;
                        overflow: elide;
                    }
                    if root.now-artist-id == "": Text {
                        text: root.now-detail;
                        color: Theme.text2;
                        font-size: 12px;
                        overflow: elide;
                    }
                    if root.now-artist-id != "": CreditLine {
                        text: root.now-detail;
                        artist: root.now-artist;
                        rest: root.now-rest;
                        artist-id: root.now-artist-id;
                        artist-clicked(id) => {
                            root.open-artist(id);
                        }
                    }
                }
                VerticalLayout {
                    alignment: center;
                    HorizontalLayout {
                        spacing: 4px;
                        IconButton {
                            glyph: Glyphs.shuffle;
                            size: 32px;
                            tint: Theme.text3;
                            on: root.shuffle;
                            tip: root.shuffle ? "Shuffle on" : "Shuffle";
                            enabled: !root.controls-locked;
                            clicked => {
                                root.toggle-shuffle();
                            }
                        }
                        IconButton {
                            glyph: Glyphs.prev;
                            tip: "Previous (Ctrl+Left)";
                            enabled: !root.controls-locked;
                            clicked => {
                                root.prev();
                            }
                        }
                        IconButton {
                            glyph: (root.active && !root.paused) ? Glyphs.pause : Glyphs.play;
                            size: 44px;
                            solid: true;
                            tip: (root.active && !root.paused) ? "Pause (Space)" : "Play (Space)";
                            enabled: !root.controls-locked;
                            clicked => {
                                root.toggle-pause();
                            }
                        }
                        IconButton {
                            glyph: Glyphs.next;
                            tip: "Next (Ctrl+Right)";
                            enabled: !root.controls-locked;
                            clicked => {
                                root.next();
                            }
                        }
                        Rectangle {
                            min-width: 32px;
                            max-width: 32px;
                            IconButton {
                                glyph: Glyphs.repeat;
                                size: 32px;
                                tint: Theme.text3;
                                on: root.repeat-mode > 0;
                                tip: root.repeat-mode == 0 ? "Repeat" : (root.repeat-mode == 1 ? "Repeat all" : "Repeat one");
                                enabled: !root.controls-locked;
                                clicked => {
                                    root.cycle-repeat();
                                }
                            }
                            if root.repeat-mode == 2: Text {
                                text: "1";
                                color: Theme.accent;
                                font-size: 9px;
                                font-weight: 500;
                                x: (parent.width - self.width) / 2;
                                y: (parent.height - self.height) / 2 + 1px;
                            }
                        }
                    }
                }
                HorizontalLayout {
                    spacing: 8px;
                    horizontal-stretch: 1;
                    Text {
                        text: root.pos-text;
                        color: Theme.text3;
                        font-size: 11px;
                        vertical-alignment: center;
                        horizontal-alignment: right;
                        min-width: 36px;
                    }
                    VerticalLayout {
                        alignment: center;
                        horizontal-stretch: 1;
                        seek-bar := Scrub {
                            value: Math.min(Math.max(root.progress, 0), 1);
                            enabled: !root.controls-locked;
                            bubble: root.duration-secs > 0 ? root.clock(seek-bar.hover-fraction * root.duration-secs) : "";
                            committed(f) => {
                                root.seek(f);
                            }
                        }
                    }
                    Text {
                        text: root.dur-text;
                        color: Theme.text3;
                        font-size: 11px;
                        vertical-alignment: center;
                        min-width: 36px;
                    }
                }
                HorizontalLayout {
                    spacing: 6px;
                    min-width: 120px;
                    max-width: 120px;
                    VerticalLayout {
                        alignment: center;
                        Icon {
                            glyph: Glyphs.volume;
                            tint: Theme.text3;
                            width: 18px;
                            height: 18px;
                        }
                    }
                    VerticalLayout {
                        alignment: center;
                        horizontal-stretch: 1;
                        volume-bar := Scrub {
                            value: root.volume;
                            live: true;
                            bubble: "\{Math.round(volume-bar.hover-fraction * 100)}%";
                            committed(f) => {
                                root.volume = f;
                                root.set-volume(f);
                            }
                        }
                    }
                }
            }
        }
    }

    if TipState.shown && TipState.text != "": Rectangle {
        z: 100;
        property <length> tip-w: Math.min(tip-label.preferred-width, 320px) + 16px;
        width: self.tip-w;
        height: tip-label.preferred-height + 10px;
        x: Math.min(Math.max(TipState.x - self.tip-w / 2, 6px), root.width - self.tip-w - 6px);
        y: TipState.above ? TipState.y - self.height - 6px : TipState.y + 6px;
        border-radius: 5px;
        background: Theme.text;
        tip-label := Text {
            text: TipState.text;
            color: Theme.bg;
            font-size: 11px;
            wrap: word-wrap;
            x: 8px;
            y: 5px;
            width: parent.width - 16px;
        }
    }
    }
}
