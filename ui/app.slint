import { Theme, TipState, Glyphs, TrackItem, LyricLine, PartyMember } from "theme.slint";
import { AppState } from "state.slint";
import { LayoutTabs } from "layout-tabs.slint";
import { LayoutSidebar } from "layout-sidebar.slint";
import { LayoutArt } from "layout-art.slint";
import { LayoutCompact } from "layout-compact.slint";
export { TrackItem, LyricLine, PartyMember, Theme, TipState } from "theme.slint";
export { AppState } from "state.slint";

export component LoginWindow inherits Window {
    title: "Sign in to YouTube Music";
    icon: @image-url("../assets/icon.png");
    background: Theme.bg;
    min-width: 480px;
    max-width: 480px;
    preferred-width: 480px;
    min-height: 720px;
    max-height: 720px;
    preferred-height: 720px;
}

export component MainWindow inherits Window {
    title: "ytmusic-lite";
    icon: @image-url("../assets/icon.png");
    min-width: 760px;
    min-height: 460px;
    preferred-width: 980px;
    preferred-height: 620px;
    // Changing AppState.repaint-nonce by one makes the whole window repaint (see state.slint)
    background: Math.mod(AppState.repaint-nonce, 2) == 0 ? Theme.bg : Theme.bg-alt;
    default-font-size: 13px;


    /// Clears the no-animation flag a moment after a shortcut key has moved between screens
    Timer {
        interval: 250ms;
        running: AppState.skip-anim;
        triggered => {
            AppState.skip-anim = false;
        }
    }

    /// Screens ask for the keyboard to go back to the shortcuts below
    property <int> refocus: AppState.keys-focus-nonce;
    changed refocus => {
        fs.focus();
    }

    fs := FocusScope {
        init => {
            self.focus();
        }
        key-pressed(e) => {
            // typing in the search box is handled by the box itself, so these only fire elsewhere
            if (e.text == " ") {
                AppState.toggle-pause();
                return accept;
            }
            if (e.text == Key.LeftArrow) {
                if (e.modifiers.control) {
                    AppState.prev();
                } else {
                    AppState.seek-by(-5.0);
                }
                return accept;
            }
            if (e.text == Key.RightArrow) {
                if (e.modifiers.control) {
                    AppState.next();
                } else {
                    AppState.seek-by(5.0);
                }
                return accept;
            }
            if (e.text == Key.UpArrow || e.text == Key.DownArrow) {
                AppState.volume = Math.max(0.0, Math.min(1.0, AppState.volume + (e.text == Key.UpArrow ? 0.05 : -0.05)));
                AppState.set-volume(AppState.volume);
                return accept;
            }
            if (e.text == "/" || (e.modifiers.control && e.text == "f")) {
                // a shortcut key: no animation, it is used far too often to wait for
                AppState.skip-anim = true;
                AppState.settings-open = false;
                AppState.artist-open = false;
                AppState.close-artist();
                AppState.tab = 0;
                AppState.view-changed(0);
                AppState.want-search-focus = true;
                return accept;
            }
            if (e.text == Key.Escape) {
                AppState.skip-anim = true;
                if (AppState.artist-open) {
                    AppState.artist-back();
                } else if (AppState.settings-open) {
                    AppState.settings-open = false;
                    AppState.view-changed(AppState.tab);
                }
                fs.focus();
                return accept;
            }
            return reject;
        }
        if Theme.layout == 0: LayoutTabs { }
        if Theme.layout == 1: LayoutSidebar { }
        if Theme.layout == 2: LayoutArt { }
        if Theme.layout == 3: LayoutCompact { }

    if TipState.shown && TipState.text != "": Rectangle {
        z: 100;
        property <length> tip-w: Math.min(tip-label.preferred-width, 320px) + 16px;
        width: self.tip-w;
        height: tip-label.preferred-height + 10px;
        x: Math.min(Math.max(TipState.x - self.tip-w / 2, 6px), root.width - self.tip-w - 6px);
        y: TipState.above ? TipState.y - self.height - 6px : TipState.y + 6px;
        border-radius: 5px;
        background: Theme.text;
        tip-label := Text {
            text: TipState.text;
            color: Theme.bg;
            font-size: 11px;
            wrap: word-wrap;
            x: 8px;
            y: 5px;
            width: parent.width - 16px;
        }
    }
    }
}
