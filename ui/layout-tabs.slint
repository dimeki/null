import { Theme } from "theme.slint";
import { TabBar } from "chrome-tabbar.slint";
import { QueuePanel } from "chrome-queue.slint";
import { PlayerBar } from "chrome-player.slint";
import { ScreenHost } from "screen-host.slint";

/// Tabs along the top, the queue beside the screens, the player along the bottom
export component LayoutTabs inherits VerticalLayout {
    HorizontalLayout {
        VerticalLayout {
            padding: 14px;
            spacing: 10px;
            horizontal-stretch: 1;
            TabBar { }
            ScreenHost {
                vertical-stretch: 1;
            }
        }
        Rectangle {
            width: 1px;
            background: Theme.border;
        }
        QueuePanel { }
    }
    Rectangle {
        height: 1px;
        background: Theme.border;
    }
    PlayerBar { }
}
